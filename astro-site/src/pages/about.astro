</BaseLayout>

<style>
  .dossier-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid var(--ink);
  }

  .dossier-header h1 {
    margin-top: 0.5rem;
    margin-bottom: 0;
  }

  .cv-list {
    list-style: none;
    padding-left: 0;
  }

  .cv-list li {
    padding: 0.6rem 0;
    border-bottom: 1px dotted var(--border);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }

  .cv-list .stamp {
    margin-left: auto;
    flex-shrink: 0;
  }

  @media screen and (max-width: 480px) {
    .cv-list li {
      flex-direction: column;
      gap: 0.25rem;
    }

    .cv-list .stamp {
      margin-left: 0;
    }
  }
</style>
