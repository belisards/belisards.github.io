---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadYaml } from '../lib/data';

const about = loadYaml('about.yml');
---

<BaseLayout title="Bio" description="Adriano Belisario — data journalist, researcher, educator.">
  <div class="page-wrapper">
    <div class="content-wrapper">

      <div class="page-header">
        <h1 id="page-title">Adriano Belisario</h1>
        <p class="secondary">Data journalist, researcher, educator</p>
      </div>

      <div class="reveal" set:html={about.bio} />

      <div class="section-label section-label--warm reveal">Awards & Recognitions</div>
      <div class="reveal">
        <ul class="cv-list">
          {about.awards.map((a: any) => (
            <li>
              {a.highlight ? <span class="signal-highlight">{a.title}</span> : a.title}
              {' '}<span class={`data-badge${a.highlight ? ' data-badge--warm' : ''}`}>{a.year}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="section-label section-label--violet reveal">Education</div>
      <div class="reveal">
        <ul class="cv-list">
          {about.education.map((e: any) => (
            <li>
              <strong>{e.degree}</strong>{e.note ? ` ${e.note}` : ''}<br />
              <span class="faded">{e.institution}. {e.year}.</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="section-label reveal">Courses</div>
      <div class="reveal">
        <ul class="cv-list">
          {about.courses.map((c: any) => (
            <li>{c.year}, {c.location}. {c.title}. <span class="faded">{c.institution}.</span></li>
          ))}
        </ul>
      </div>

      <div class="section-label reveal">Professional Experience</div>
      <div class="reveal">
        <ul class="cv-list">
          {about.experience.map((e: any) => (
            <li><strong>{e.org}</strong> — {e.role} <span class={`data-badge${e.style ? ` data-badge--${e.style}` : ''}`}>{e.period}</span></li>
          ))}
        </ul>
      </div>

      <div class="section-label section-label--teal reveal">Teaching Experience</div>
      <div class="reveal">
        <Fragment set:html={about.teaching.intro} />
        <ul class="cv-list">
          {about.teaching.positions.map((t: any) => (
            <li><strong>{t.org}</strong> — {t.role} <span class="data-badge">{t.period}</span></li>
          ))}
        </ul>
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .page-header h1 {
    margin-bottom: 0.25rem;
  }

  .cv-list {
    list-style: none;
    padding-left: 0;
  }

  .cv-list li {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }

  .cv-list .data-badge {
    margin-left: auto;
    flex-shrink: 0;
  }

  @media screen and (max-width: 480px) {
    .cv-list li {
      flex-direction: column;
      gap: 0.25rem;
    }

    .cv-list .data-badge {
      margin-left: 0;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { ScrambleTextPlugin } from "gsap/ScrambleTextPlugin";
  gsap.registerPlugin(ScrollTrigger, ScrambleTextPlugin);

  // ScrambleText heading decode
  const title = document.getElementById("page-title");
  if (title && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    gsap.from(title, {
      scrambleText: { text: title.textContent || "", chars: "01!<>-_\\/[]{}=+*^?#", revealDelay: 0.3, speed: 0.4 },
      duration: 1.2, delay: 0.4,
    });
  }

  document.querySelectorAll('.cv-list').forEach(list => {
    gsap.from(list.querySelectorAll('li'), {
      x: -20,
      opacity: 0,
      duration: 0.4,
      ease: "power2.out",
      stagger: 0.05,
      scrollTrigger: {
        trigger: list,
        start: "top 85%",
        once: true,
      },
    });
  });
</script>
