---
import BaseLayout from '../layouts/BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { loadYaml } from '../lib/data';

const events = loadYaml('events.yml');

// Flatten all sections into one chronological timeline (newest first).
// Each event keeps its section as a type tag.
const yearKey = (label: string) => {
  const m = String(label).match(/(\d{4})(?:\D+(\d{2,4}))?/);
  if (!m) return [0, 0];
  const start = Number(m[1]);
  const end = m[2] ? Number(m[2].length === 2 ? m[1].slice(0, 2) + m[2] : m[2]) : start;
  return [end, start];
};

const groups = new Map<string, any[]>();
for (const section of events.sections) {
  for (const entry of section.entries) {
    const label = String(entry.year);
    if (!groups.has(label)) groups.set(label, []);
    groups.get(label)!.push({ ...entry, type: section.title, style: section.style || 'blue' });
  }
}

const timeline = [...groups.entries()]
  .map(([year, items]) => ({ year, key: yearKey(year), items }))
  .sort((a, b) => b.key[0] - a.key[0] || b.key[1] - a.key[1]);

const yearId = (y: string) => `y-${y.replace(/[^0-9]+/g, '-')}`;

const tocItems = timeline.map((g) => ({ label: g.year, id: yearId(g.year) }));
---

<BaseLayout title="Events" description="Conferences, lectures, workshops, and courses.">
  <div class="page-wrapper">
    <div class="page-with-toc">
      <TableOfContents items={tocItems} />
      <div class="content-wrapper">

        <div class="page-header">
          <h1 id="page-title">Events</h1>
          <p class="secondary">Conferences, lectures, workshops, and courses across four continents.</p>
        </div>

        <p class="reveal" set:html={events.intro} />

        <div class="timeline">
          {timeline.map((group) => (
            <div class="timeline-entry reveal" id={yearId(group.year)}>
              <div class="timeline-date"><span class="data-badge">{group.year}</span></div>
              <div class="timeline-content">
                {group.items.map((entry: any, eIdx: number) => (
                  <div class={`timeline-event${eIdx > 0 ? ' timeline-event--next' : ''}`}>
                    <div class="timeline-meta">
                      <span class={`event-type event-type--${entry.style}`}>{entry.type}</span>
                      {entry.location && <span class="timeline-location">// {entry.location}</span>}
                    </div>
                    {entry.items.map((item: any, iIdx: number) => (
                      <>
                        {item.location && <div class="timeline-location" style={iIdx > 0 ? 'margin-top:0.75rem' : undefined}>// {item.location}</div>}
                        <div style={!item.location && iIdx > 0 ? 'margin-top:0.5rem' : undefined} set:html={item.text} />
                      </>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-with-toc {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 2rem;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  @media screen and (max-width: 1024px) {
    .page-with-toc {
      display: block;
    }
  }

  .page-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .page-header h1 {
    margin-bottom: 0.25rem;
  }

  .timeline {
    position: relative;
    padding-left: 0;
    margin-bottom: 1rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 60px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, var(--signal-primary), var(--ink-tertiary));
    border-radius: 1px;
  }

  .timeline-entry {
    display: flex;
    gap: 1.5rem;
    padding: 1rem 0;
    position: relative;
  }

  .timeline-entry::before {
    content: '';
    position: absolute;
    left: 55px;
    top: 1.35rem;
    width: 12px;
    height: 12px;
    background: var(--canvas);
    border: 2px solid var(--signal-primary);
    border-radius: 50%;
    z-index: 1;
  }

  .timeline-date {
    flex-shrink: 0;
    width: 45px;
    text-align: right;
  }

  .timeline-date .data-badge {
    font-size: 0.6rem;
    padding: 0.08rem 0.35rem;
  }

  .timeline-content {
    padding-left: 1.5rem;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .timeline-event--next {
    margin-top: 1.25rem;
  }

  .timeline-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin-bottom: 0.25rem;
  }

  .timeline-meta .timeline-location {
    margin-bottom: 0;
  }

  .event-type {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-secondary);
  }

  .event-type::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal-primary);
  }

  .event-type--warm::before { background: var(--signal-warm); }
  .event-type--teal::before { background: var(--signal-teal); }
  .event-type--violet::before { background: var(--signal-violet); }

  .timeline-location {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-tertiary);
    letter-spacing: 0.04em;
    margin-bottom: 0.25rem;
  }

  @media screen and (max-width: 768px) {
    .timeline::before {
      left: 10px;
    }

    .timeline-entry {
      flex-direction: column;
      padding-left: 2rem;
      gap: 0.25rem;
    }

    .timeline-entry::before {
      left: 5px;
      top: 0.3rem;
      width: 10px;
      height: 10px;
    }

    .timeline-date {
      text-align: left;
      width: auto;
    }

    .timeline-content {
      padding-left: 0;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { ScrambleTextPlugin } from "gsap/ScrambleTextPlugin";
  gsap.registerPlugin(ScrollTrigger, ScrambleTextPlugin);

  // ScrambleText heading decode
  const title = document.getElementById("page-title");
  if (title && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    gsap.from(title, {
      scrambleText: { text: title.textContent || "", chars: "01!<>-_\\/[]{}=+*^?#", revealDelay: 0.3, speed: 0.4 },
      duration: 1.2, delay: 0.4,
    });
  }

  // Draw timeline lines as they scroll into view
  document.querySelectorAll('.timeline').forEach(timeline => {
    gsap.from(timeline, {
      '--line-scale': 0,
      scrollTrigger: {
        trigger: timeline,
        start: "top 80%",
        end: "bottom 20%",
        scrub: 0.5,
      },
    });
  });
</script>
