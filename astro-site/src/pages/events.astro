---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadYaml } from '../lib/data';

const events = loadYaml('events.yml');
---

<BaseLayout title="Events" description="Conferences, lectures, workshops, and courses.">
  <div class="page-wrapper">
    <div class="content-wrapper">

      <div class="page-header">
        <h1 id="page-title">Events</h1>
        <p class="secondary">Conferences, lectures, workshops, and courses across four continents.</p>
      </div>

      {events.sections.map((section: any, sIdx: number) => (
        <>
          <div class={`section-label${section.style ? ` section-label--${section.style}` : ''} reveal`}>{section.title}</div>

          {sIdx === 0 && <p class="reveal" set:html={events.intro} />}

          <div class="timeline">
            {section.entries.map((entry: any) => (
              <div class="timeline-entry reveal">
                <div class="timeline-date"><span class={`data-badge${entry.badge_style ? ` data-badge--${entry.badge_style}` : ''}`}>{entry.year}</span></div>
                <div class="timeline-content">
                  {entry.location && <div class="timeline-location">// {entry.location}</div>}
                  {entry.items.map((item: any, iIdx: number) => (
                    <>
                      {item.location && <div class={`timeline-location${iIdx > 0 ? '' : ''}`} style={iIdx > 0 ? 'margin-top:0.75rem' : undefined}>// {item.location}</div>}
                      <div style={!item.location && iIdx > 0 ? 'margin-top:0.5rem' : undefined} set:html={item.text} />
                    </>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </>
      ))}

    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .page-header h1 {
    margin-bottom: 0.25rem;
  }

  .timeline {
    position: relative;
    padding-left: 0;
    margin-bottom: 1rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 60px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, var(--signal-primary), var(--ink-tertiary));
    border-radius: 1px;
  }

  .timeline-entry {
    display: flex;
    gap: 1.5rem;
    padding: 1rem 0;
    position: relative;
  }

  .timeline-entry::before {
    content: '';
    position: absolute;
    left: 55px;
    top: 1.35rem;
    width: 12px;
    height: 12px;
    background: var(--canvas);
    border: 2px solid var(--signal-primary);
    border-radius: 50%;
    z-index: 1;
  }

  .timeline-date {
    flex-shrink: 0;
    width: 45px;
    text-align: right;
  }

  .timeline-date .data-badge {
    font-size: 0.6rem;
    padding: 0.08rem 0.35rem;
  }

  .timeline-content {
    padding-left: 1.5rem;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .timeline-location {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-tertiary);
    letter-spacing: 0.04em;
    margin-bottom: 0.25rem;
  }

  @media screen and (max-width: 768px) {
    .timeline::before {
      left: 10px;
    }

    .timeline-entry {
      flex-direction: column;
      padding-left: 2rem;
      gap: 0.25rem;
    }

    .timeline-entry::before {
      left: 5px;
      top: 0.3rem;
      width: 10px;
      height: 10px;
    }

    .timeline-date {
      text-align: left;
      width: auto;
    }

    .timeline-content {
      padding-left: 0;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { ScrambleTextPlugin } from "gsap/ScrambleTextPlugin";
  gsap.registerPlugin(ScrollTrigger, ScrambleTextPlugin);

  // ScrambleText heading decode
  const title = document.getElementById("page-title");
  if (title && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    gsap.from(title, {
      scrambleText: { text: title.textContent || "", chars: "01!<>-_\\/[]{}=+*^?#", revealDelay: 0.3, speed: 0.4 },
      duration: 1.2, delay: 0.4,
    });
  }

  // Draw timeline lines as they scroll into view
  document.querySelectorAll('.timeline').forEach(timeline => {
    gsap.from(timeline, {
      '--line-scale': 0,
      scrollTrigger: {
        trigger: timeline,
        start: "top 80%",
        end: "bottom 20%",
        scrub: 0.5,
      },
    });
  });
</script>
