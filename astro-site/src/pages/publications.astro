---
import BaseLayout from '../layouts/BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { loadYaml } from '../lib/data';

const pubs = loadYaml('publications.yml');
const englishSection = pubs.sections[0];
const ptSection = pubs.sections[1];

const tocItems = [
  { label: 'English', id: 'english' },
  { label: 'Portuguese', id: 'portuguese' },
];
---

<BaseLayout title="Publications" description="Academic papers, journalistic investigations, books, and tutorials.">
  <div class="page-wrapper">
    <div class="page-with-toc">
      <TableOfContents items={tocItems} />
      <div class="content-wrapper">

        <div class="page-header">
          <h1 id="page-title">Publications</h1>
          <p class="secondary">Texts published since 2008 — data investigations, academic papers, books, and tutorials in English and Portuguese.</p>
          <div style="margin-top: 0.75rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <span class="data-badge data-badge--violet">Academic</span>
            <span class="data-badge">Journalism</span>
            <span class="data-badge data-badge--teal">Tutorial</span>
          </div>
        </div>

        <h2 class="reveal" id="english">{englishSection.title}</h2>

        {englishSection.entries.map((entry: any) => (
          <div class={`pub-entry pub-entry--${entry.type} reveal`}>
            <div>{entry.featured && <span class="pub-featured"></span>}<span class="pub-entry__title">{entry.url ? <a href={entry.url}>{entry.title}</a> : entry.title}</span></div>
            {entry.meta && <div class="pub-entry__meta" set:html={entry.meta} />}
          </div>
        ))}

        <h2 class="reveal" id="portuguese">{ptSection.title}</h2>

      {ptSection.subsections.map((sub: any) => (
        <>
          <div class="pub-category reveal">
            <span>{sub.title}</span>
            {sub.badge && <span class={`data-badge${sub.badge_style ? ` data-badge--${sub.badge_style}` : ''}`}>{sub.badge}</span>}
          </div>

          {sub.books && (
            <div class="book-gallery reveal" id="book-gallery">
              {sub.books.map((book: any) => (
                <div class="book-item" data-full={book.image}>
                  <img src={book.image} alt={book.alt} loading="lazy" />
                  <div class="book-item__caption" set:html={book.caption} />
                </div>
              ))}
            </div>
          )}

          {sub.entries && sub.entries.map((entry: any) => (
            <div class={`pub-entry pub-entry--${entry.type} reveal`}>
              <div>{entry.featured && <span class="pub-featured"></span>}<span class="pub-entry__title">{entry.url ? <a href={entry.url}>{entry.title}</a> : entry.title}</span></div>
              {entry.meta && <div class="pub-entry__meta" set:html={entry.meta} />}
            </div>
          ))}
        </>
        ))}

      </div>
    </div>
  </div>

  <div class="lightbox-overlay" id="lightbox">
    <img src="" alt="" id="lightbox-img" />
  </div>
</BaseLayout>

<style>
  .page-with-toc {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 2rem;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  @media screen and (max-width: 1024px) {
    .page-with-toc {
      display: block;
    }
  }

  .page-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .page-header h1 {
    margin-bottom: 0.25rem;
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrambleTextPlugin } from "gsap/ScrambleTextPlugin";
  gsap.registerPlugin(ScrambleTextPlugin);

  // ScrambleText heading decode
  const title = document.getElementById("page-title");
  if (title && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    gsap.from(title, {
      scrambleText: {
        text: title.textContent || "",
        chars: "01!<>-_\\/[]{}=+*^?#",
        revealDelay: 0.3,
        speed: 0.4,
      },
      duration: 1.2,
      delay: 0.4,
    });
  }

  const gallery = document.getElementById('book-gallery');
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;

  gallery?.addEventListener('click', (e) => {
    const item = (e.target as HTMLElement).closest('.book-item');
    if (!item) return;
    const src = item.getAttribute('data-full');
    if (src && lightboxImg && lightbox) {
      lightboxImg.src = src;
      lightbox.classList.add('active');
    }
  });

  lightbox?.addEventListener('click', () => {
    lightbox.classList.remove('active');
    if (lightboxImg) lightboxImg.src = '';
  });
</script>
