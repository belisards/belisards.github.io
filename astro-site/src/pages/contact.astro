---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadYaml } from '../lib/data';

const contact = loadYaml('contact.yml');
---

<BaseLayout title="Contact" description="Get in touch with Adriano Belisario.">
  <div class="page-wrapper">
    <div class="content-wrapper">

      <div class="page-header">
        <h1>Connect</h1>
        <p class="secondary">Get in touch</p>
      </div>

      <div class="contact-card data-panel reveal">
        <div class="contact-links">
          {contact.links.map((link: any) => (
            <a href={link.url} target="_blank" rel="noopener" class={`contact-item${link.color === 'violet' ? ' contact-item--violet' : link.color === 'blue' ? ' contact-item--blue' : ''}`}>
              <span class={`contact-icon${link.color ? ` contact-icon--${link.color}` : ''}`}>{link.icon}</span>
              <span class="contact-label">{link.label}</span>
            </a>
          ))}
        </div>

        <hr />

        <p class="contact-email">
          Or drop a line at <strong>{contact.email}</strong>
        </p>
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .page-header h1 {
    margin-bottom: 0.25rem;
  }

  .contact-card {
    max-width: 500px;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .contact-item:hover {
    border-color: var(--signal-primary);
    box-shadow: 0 0 0 1px var(--signal-primary), var(--shadow-sm);
    text-decoration: none;
  }

  .contact-item--violet:hover {
    border-color: var(--signal-violet);
    box-shadow: 0 0 0 1px var(--signal-violet), var(--shadow-sm);
  }

  .contact-icon {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--canvas-raised);
    background: var(--ink);
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .contact-icon--blue {
    background: var(--signal-primary);
  }

  .contact-icon--sky {
    background: #0085ff;
  }

  .contact-icon--violet {
    background: var(--signal-violet);
  }

  .contact-label {
    font-size: 0.9rem;
    color: var(--ink);
  }

  .contact-email {
    font-size: 0.9rem;
    color: var(--ink-secondary);
  }
</style>
