---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    title: 'Congretimbau',
    desc: 'BERT-based model specialized in Brazilian Portuguese law bills.',
    image: '/images/projects/congretimbau.png',
    date: '2024',
    categories: ['Python', 'NLP', 'ML'],
    links: { model: 'https://huggingface.co/belisards/congretimbau' },
  },
  {
    title: 'Smart Image Sorter',
    desc: 'User-friendly tool for zero-shot image classification. Developed with Bellingcat.',
    image: '/images/projects/smart_image_sorter.jpg',
    date: '2024',
    categories: ['Python'],
    links: { tutorial: 'https://www.bellingcat.com/resources/how-tos/2024/08/15/easy-ai-zero-shot-ai-image-classification-smart-image-sorter/', code: 'https://github.com/bellingcat/smart-image-sorter' },
  },
  {
    title: 'UNHCR Geodata Extractor',
    desc: 'Explore camp boundaries and points from UNHCR\'s geodata repository.',
    image: '/images/projects/unhcr_geodata.png',
    date: '2024',
    categories: ['Python', 'Streamlit', 'Geodata'],
    links: { app: 'https://unhcrdata.streamlit.app/', code: 'https://github.com/belisards/unhcr_geodata' },
  },
  {
    title: 'Forced Displacement Microdata',
    desc: 'Shiny dashboard about gaps in microdata on forced displacement.',
    image: '/images/projects/fdpatlas.png',
    date: '2023',
    categories: ['R', 'Shiny'],
    links: { dashboard: 'https://rstudio.unhcr.org/FDMAtlas/', code: 'https://github.com/belisards/FDPDataAtlas' },
  },
  {
    title: 'Gun Violence Classification Model',
    desc: 'BERTimbau fine-tuned to detect gun violence reports in Brazilian Portuguese.',
    image: '/images/projects/gunviolenceptbr.png',
    date: '2023',
    categories: ['Python', 'NLP'],
    links: { model: 'https://huggingface.co/belisards/gun_violence_ptbr', paper: 'https://arxiv.org/abs/2401.12989', code: 'https://github.com/belisards/gunviolence_ptbr' },
  },
  {
    title: 'Fragile Families',
    desc: 'Statistical models for the Fragile Families and Child Wellbeing Study using gradient boosting.',
    image: '/images/projects/ff_challenge.png',
    date: '2023',
    categories: ['Python', 'ML'],
    links: { code: 'https://github.com/belisards/ff_applied_ml/' },
  },
  {
    title: 'Corporate Network Visualization',
    desc: 'Interactive data visualization of the bus owners\' network in Rio de Janeiro.',
    image: '/images/projects/bus_network.png',
    date: '2017',
    categories: ['Web'],
    links: { viz: 'https://apublica.org/riobus/html/', article: 'https://apublica.org/2017/08/a-teia-dos-donos-do-transporte-no-rio/', code: 'https://github.com/belisards/mapa-onibus-rj' },
  },
];
---

<BaseLayout title="Code" description="Data projects and code repositories.">
  <div class="page-wrapper">

    <div class="page-header-wide">
      <h1>Projects</h1>
      <p class="secondary">Data projects and code repositories — NLP, geodata, network analysis, machine learning.</p>
    </div>

    <div class="project-grid">
      {projects.map((project) => (
        <div class="project-card reveal">
          <div class="project-card__image-wrap">
            <img src={project.image} alt={project.title} class="project-card__image" loading="lazy" />
          </div>
          <div class="project-card__body">
            <div class="project-card__meta">
              <span>{project.date}</span>
              {project.categories.map(cat => (
                <span class="category-pill">{cat}</span>
              ))}
            </div>
            <h3 class="project-card__title">{project.title}</h3>
            <p class="project-card__desc">{project.desc}</p>
            <div class="project-card__links">
              {Object.entries(project.links).map(([label, url]) => (
                <a href={url} target="_blank" rel="noopener" class="project-link">{label} &#x2197;</a>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</BaseLayout>

<style>
  .page-header-wide {
    max-width: var(--content-width);
    margin: 2rem auto;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .page-header-wide h1 {
    margin-bottom: 0.25rem;
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  ScrollTrigger.batch(".project-card", {
    onEnter: (elements) => {
      gsap.fromTo(elements,
        { y: 40, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.5, ease: "power2.out", stagger: 0.1 }
      );
    },
    start: "top 90%",
    once: true,
  });
</script>
