---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadProjects } from '../lib/data';

const imageMap: Record<string, string> = {
  'cover.png': 'png',
  'feat_image.jpg': 'jpg',
};

const projects = loadProjects().map(p => ({
  title: p.title,
  desc: p.description?.trim() || '',
  image: `/images/projects/${p.slug}.${p.image === 'feat_image.jpg' ? 'jpg' : 'png'}`,
  date: new Date(p.date).getFullYear().toString(),
  categories: (p.categories || []).map((c: string) => c.charAt(0).toUpperCase() + c.slice(1)),
  links: p.links || {},
}));
---

<BaseLayout title="Code" description="Data projects and code repositories.">
  <div class="page-wrapper">

    <div class="page-header-wide">
      <h1 id="page-title">Projects</h1>
      <p class="secondary">Data projects and code repositories — NLP, geodata, network analysis, machine learning.</p>
    </div>

    <div class="project-grid">
      {projects.map((project) => (
        <div class="project-card reveal">
          <div class="project-card__image-wrap">
            <img src={project.image} alt={project.title} class="project-card__image" loading="lazy" />
          </div>
          <div class="project-card__body">
            <div class="project-card__meta">
              <span>{project.date}</span>
              {project.categories.map(cat => (
                <span class="category-pill">{cat}</span>
              ))}
            </div>
            <h3 class="project-card__title">{project.title}</h3>
            <p class="project-card__desc">{project.desc}</p>
            <div class="project-card__links">
              {Object.entries(project.links).map(([label, url]) => (
                <a href={url} target="_blank" rel="noopener" class="project-link">{label} &#x2197;</a>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</BaseLayout>

<style>
  .page-header-wide {
    max-width: var(--content-width);
    margin: 2rem auto;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .page-header-wide h1 {
    margin-bottom: 0.25rem;
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { ScrambleTextPlugin } from "gsap/ScrambleTextPlugin";
  gsap.registerPlugin(ScrollTrigger, ScrambleTextPlugin);

  // ScrambleText heading decode
  const title = document.getElementById("page-title");
  if (title && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    gsap.from(title, {
      scrambleText: { text: title.textContent || "", chars: "01!<>-_\\/[]{}=+*^?#", revealDelay: 0.3, speed: 0.4 },
      duration: 1.2, delay: 0.4,
    });
  }

  ScrollTrigger.batch(".project-card", {
    onEnter: (elements) => {
      gsap.fromTo(elements,
        { y: 40, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.5, ease: "power2.out", stagger: 0.1 }
      );
    },
    start: "top 90%",
    once: true,
  });
</script>
