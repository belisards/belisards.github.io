---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadYaml } from '../lib/data';
import { loadProjects } from '../lib/data';
import { CODE_FRAGMENTS, KEYWORDS, DATA_VALUES } from '../data/hero-corpus';

/**
 * HERO_MODE: Switch between hero animation concepts
 *   "terminal"  — Concept A: Live investigation feed with real code/text
 *   "signal"    — Concept B: Noise-to-meaning with emerging text fragments
 */
const HERO_MODE: "terminal" | "signal" = "signal";

// ── Pull real text from YAML data at build time ──
const pubs = loadYaml('publications.yml');
const events = loadYaml('events.yml');
const about = loadYaml('about.yml');
const projects = loadProjects();

// Extract publication titles (all sections, all entries)
function extractPubTitles(data: any): string[] {
  const titles: string[] = [];
  for (const section of data.sections || []) {
    for (const entry of section.entries || []) {
      if (entry.title) titles.push(entry.title);
    }
    for (const sub of section.subsections || []) {
      for (const entry of sub.entries || []) {
        if (entry.title) titles.push(entry.title);
      }
      for (const book of sub.books || []) {
        if (book.title) titles.push(book.title);
      }
    }
  }
  return titles;
}

// Extract talk/event titles (strip HTML tags)
function extractEventTitles(data: any): string[] {
  const titles: string[] = [];
  for (const section of data.sections || []) {
    for (const group of section.entries || []) {
      for (const item of group.items || []) {
        const text = item.text?.replace(/<[^>]+>/g, '') || '';
        const match = text.match(/^([^.]+)/);
        if (match) titles.push(match[1].trim());
      }
    }
  }
  return titles;
}

// Extract org names from experience
function extractOrgs(data: any): string[] {
  return (data.experience || []).map((e: any) => e.org).filter(Boolean);
}

// Build the corpus object to inject into client
const heroCorpus = {
  publications: extractPubTitles(pubs),
  events: extractEventTitles(events),
  orgs: [...extractOrgs(about), 'Oxford Internet Institute', 'Bellingcat', 'Forensic Architecture'],
  projects: projects.map((p: any) => p.title || p.description || '').filter(Boolean),
  code: CODE_FRAGMENTS,
  keywords: KEYWORDS,
  data: DATA_VALUES,
};
---

<BaseLayout title="Adriano Belisario" description="Data journalist & researcher. Oxford, UNHCR, Bellingcat, Forensic Architecture." hideNavInitially={true}>

<!-- Inject YAML-sourced corpus for client-side hero animation -->
<script is:inline define:vars={{ heroCorpus }}>
  window.__HERO_CORPUS__ = heroCorpus;
</script>

  <!-- ========== HERO ========== -->
  <section class="hero" id="hero" data-hero-mode={HERO_MODE}>
    <canvas id="hero-canvas" aria-hidden="true"></canvas>
    <div class="hero__grain" aria-hidden="true"></div>

    <div class="hero__content">
      <p class="hero__catchphrase mono" id="hero-catchphrase">Finding signal in the noise</p>
      <h1 class="hero__name" id="hero-name" aria-label="Adriano Belisario">
        <span class="hero__line" id="line-1">Adriano</span>
        <span class="hero__line" id="line-2">Belisario</span>
      </h1>
    </div>

    <div class="hero__scroll" id="hero-scroll">
      <div class="hero__scroll-line"><span></span></div>
    </div>
  </section>

  <!-- ========== STATEMENT ========== -->
  <section class="statement">
    <div class="statement__inner">
      <p class="statement__text" id="statement-1">
        Combining expertise in communication, open&#8209;source technologies,
        and data to address important social concerns.
      </p>
    </div>
  </section>

  <!-- ========== AFFILIATIONS ========== -->
  <section class="affiliations">
    <div class="affiliations__inner">
      <p class="affiliations__text reveal">
        Currently collaborating with the
        <a href="https://www.jointdatacenter.org/">Joint Data Center on Forced Displacement</a>
        and <a href="https://netlab.eco.ufrj.br/">Netlab/UFRJ</a>.
        MSc in Social Data Science,
        <strong>Oxford Internet Institute</strong>.
      </p>
    </div>
  </section>

  <!-- ========== NAVIGATION PANELS ========== -->
  <section class="panels">
    <a href="/code/" class="panel" data-color="teal">
      <div class="panel__bg" aria-hidden="true"></div>
      <span class="panel__index mono">01</span>
      <div class="panel__body">
        <h2 class="panel__title">Code</h2>
        <p class="panel__desc">Data projects & code — NLP, geodata, network analysis, machine learning.</p>
      </div>
      <span class="panel__arrow">&rarr;</span>
    </a>
    <a href="/publications/" class="panel" data-color="violet">
      <div class="panel__bg" aria-hidden="true"></div>
      <span class="panel__index mono">02</span>
      <div class="panel__body">
        <h2 class="panel__title">Publications</h2>
        <p class="panel__desc">Academic papers, investigations, books & tutorials in English & Portuguese.</p>
      </div>
      <span class="panel__arrow">&rarr;</span>
    </a>
    <a href="/events/" class="panel" data-color="warm">
      <div class="panel__bg" aria-hidden="true"></div>
      <span class="panel__index mono">03</span>
      <div class="panel__body">
        <h2 class="panel__title">Events</h2>
        <p class="panel__desc">Conferences, lectures, workshops & courses across four continents.</p>
      </div>
      <span class="panel__arrow">&rarr;</span>
    </a>
    <a href="/about/" class="panel" data-color="blue">
      <div class="panel__bg" aria-hidden="true"></div>
      <span class="panel__index mono">04</span>
      <div class="panel__body">
        <h2 class="panel__title">About</h2>
        <p class="panel__desc">CV, education, professional experience & collaborations.</p>
      </div>
      <span class="panel__arrow">&rarr;</span>
    </a>
  </section>

  <!-- ========== LOGO STRIP ========== -->
  <section class="logo-strip">
    <p class="logo-strip__label mono">Collaborated with</p>
    <div class="logo-strip__inner">
      <img src="/images/logos/oxford.svg" alt="Oxford" class="logo-strip__img" />
      <img src="/images/logos/unhcr.svg" alt="UNHCR" class="logo-strip__img" />
      <img src="/images/logos/bellingcat.svg" alt="Bellingcat" class="logo-strip__img" />
      <img src="/images/logos/forensic-architecture.svg" alt="Forensic Architecture" class="logo-strip__img" />
      <img src="/images/logos/agencia-publica.svg" alt="Agência Pública" class="logo-strip__img" />
    </div>
  </section>

</BaseLayout>

<style>
  /* ============================
     HERO — Generative Flow Field
     ============================ */
  .hero {
    position: relative;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-left: calc(-50vw + 50%);
    background: #06060a;
  }

  #hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero__grain {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    background-repeat: repeat;
    z-index: 1;
    pointer-events: none;
    opacity: 0.4;
    mix-blend-mode: overlay;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 1.5rem;
  }

  .hero__catchphrase {
    font-size: clamp(0.8rem, 2.5vw, 1.2rem);
    letter-spacing: 0.15em;
    color: var(--signal-teal);
    margin-bottom: 2rem;
    opacity: 0;
    text-shadow: 0 0 40px rgba(13, 148, 136, 0.4);
  }

  .hero__catchphrase::after {
    content: '|';
    animation: cursorBlink 0.8s step-end infinite;
    color: var(--signal-teal);
    margin-left: 2px;
    font-weight: 300;
  }

  .hero__catchphrase.typing-done::after {
    display: none;
  }

  @keyframes cursorBlink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* Name — massive, bright white, unmissable on any screen */
  .hero__name {
    font-size: clamp(4rem, 18vw, 14rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.88;
    margin: 0;
    color: #ffffff;
    opacity: 0;
    transform: translateY(30px);
  }

  .hero__line {
    display: block;
    will-change: transform, opacity;
  }

  /* Scroll indicator */
  .hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    opacity: 0;
  }

  .hero__scroll-line span {
    display: block;
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, rgba(13, 148, 136, 0.6), transparent);
    animation: linePulse 2.5s ease-in-out infinite;
  }

  @keyframes linePulse {
    0%, 100% { transform: scaleY(0.3); opacity: 0.2; transform-origin: top; }
    50% { transform: scaleY(1); opacity: 0.8; transform-origin: top; }
  }

  /* ============================
     LOGO STRIP
     ============================ */
  .logo-strip {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    background: #f0eeeb;
    padding: 4rem 2rem;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  .logo-strip__label {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-tertiary);
    margin: 0 0 2rem;
  }

  .logo-strip__inner {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3.5rem;
    flex-wrap: wrap;
  }

  .logo-strip__img {
    height: 22px;
    opacity: 0.4;
    filter: grayscale(1);
    transition: opacity 0.4s ease, filter 0.4s ease;
  }

  .logo-strip__img:hover {
    opacity: 0.8;
    filter: grayscale(0);
  }

  /* ============================
     STATEMENT
     ============================ */
  .statement {
    padding: 10rem 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    background: #ffffff;
  }

  .statement__inner {
    max-width: 900px;
  }

  .statement__text {
    font-size: clamp(1.5rem, 4vw, 3rem);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  :global(.statement__text .char-dim) {
    color: var(--ink-tertiary);
    transition: color 0.3s ease;
  }

  /* ============================
     AFFILIATIONS
     ============================ */
  .affiliations {
    padding: 0 2rem 8rem;
    background: #ffffff;
  }

  .affiliations__inner {
    max-width: 700px;
    margin: 0 auto;
  }

  .affiliations__text {
    font-size: 1.1rem;
    line-height: 2;
    color: var(--ink-secondary);
    margin-bottom: 2rem;
  }

  /* ============================
     PANELS — with generative canvases
     ============================ */
  .panels {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    border-top: 1px solid var(--border);
    background: #ffffff;
  }

  .panel {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 2.5rem 3rem;
    text-decoration: none;
    color: var(--ink);
    border-bottom: 1px solid var(--border);
    position: relative;
    overflow: hidden;
    transition: all 0.4s ease;
  }

  /* Organic color background — always breathing */
  .panel__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .panel[data-color="teal"] .panel__bg {
    background: radial-gradient(
      ellipse 120% 200% at 0% 50%,
      rgba(13, 148, 136, 0.12) 0%,
      rgba(13, 148, 136, 0.04) 50%,
      transparent 100%
    );
    background-size: 200% 200%;
    animation: bgBreatheTeal 6s ease-in-out infinite alternate;
  }

  .panel[data-color="violet"] .panel__bg {
    background: radial-gradient(
      ellipse 120% 200% at 100% 50%,
      rgba(124, 58, 237, 0.12) 0%,
      rgba(124, 58, 237, 0.04) 50%,
      transparent 100%
    );
    background-size: 200% 200%;
    animation: bgBreatheViolet 7s ease-in-out infinite alternate;
  }

  .panel[data-color="warm"] .panel__bg {
    background: radial-gradient(
      ellipse 120% 200% at 0% 50%,
      rgba(232, 93, 4, 0.12) 0%,
      rgba(232, 93, 4, 0.04) 50%,
      transparent 100%
    );
    background-size: 200% 200%;
    animation: bgBreatheWarm 5s ease-in-out infinite alternate;
  }

  .panel[data-color="blue"] .panel__bg {
    background: radial-gradient(
      ellipse 120% 200% at 100% 50%,
      rgba(37, 99, 235, 0.12) 0%,
      rgba(37, 99, 235, 0.04) 50%,
      transparent 100%
    );
    background-size: 200% 200%;
    animation: bgBreatheBlue 8s ease-in-out infinite alternate;
  }

  /* Breathing animations — organic, different rhythms per panel */
  @keyframes bgBreatheTeal {
    0%   { opacity: 0.4; background-position: 0% 50%; }
    50%  { opacity: 0.8; }
    100% { opacity: 1; background-position: 100% 50%; }
  }

  @keyframes bgBreatheViolet {
    0%   { opacity: 0.3; background-position: 100% 0%; }
    50%  { opacity: 0.7; }
    100% { opacity: 1; background-position: 0% 100%; }
  }

  @keyframes bgBreatheWarm {
    0%   { opacity: 0.35; background-position: 0% 100%; }
    50%  { opacity: 0.75; }
    100% { opacity: 1; background-position: 100% 0%; }
  }

  @keyframes bgBreatheBlue {
    0%   { opacity: 0.3; background-position: 50% 0%; }
    50%  { opacity: 0.7; }
    100% { opacity: 1; background-position: 50% 100%; }
  }

  /* Hover locks at full intensity */
  .panel:hover .panel__bg {
    opacity: 1 !important;
    animation-play-state: paused;
  }

  .panel__index, .panel__body, .panel__arrow {
    position: relative;
    z-index: 1;
  }

  .panel__index {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    color: var(--ink-tertiary);
    flex-shrink: 0;
    width: 2rem;
    transition: color 0.3s ease;
  }

  .panel__body {
    flex: 1;
  }

  .panel__title {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 0.25rem;
    line-height: 1.1;
    color: var(--ink);
    transition: color 0.3s ease;
  }

  .panel__desc {
    font-size: 0.85rem;
    color: var(--ink-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .panel__arrow {
    font-size: 1.5rem;
    color: var(--ink-tertiary);
    flex-shrink: 0;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .panel:hover .panel__arrow {
    transform: translateX(8px);
  }

  /* Per-color hover tints */
  .panel[data-color="teal"]:hover .panel__title,
  .panel[data-color="teal"]:hover .panel__arrow,
  .panel[data-color="teal"]:hover .panel__index { color: var(--signal-teal); }

  .panel[data-color="violet"]:hover .panel__title,
  .panel[data-color="violet"]:hover .panel__arrow,
  .panel[data-color="violet"]:hover .panel__index { color: var(--signal-violet); }

  .panel[data-color="warm"]:hover .panel__title,
  .panel[data-color="warm"]:hover .panel__arrow,
  .panel[data-color="warm"]:hover .panel__index { color: var(--signal-warm); }

  .panel[data-color="blue"]:hover .panel__title,
  .panel[data-color="blue"]:hover .panel__arrow,
  .panel[data-color="blue"]:hover .panel__index { color: var(--signal-primary); }

  /* ============================
     RESPONSIVE
     ============================ */
  @media screen and (max-width: 768px) {
    .hero__name {
      font-size: clamp(3.2rem, 18vw, 6rem);
    }

    .hero__catchphrase {
      font-size: clamp(0.7rem, 3.5vw, 0.95rem);
      margin-bottom: 1.2rem;
    }

    .logo-strip {
      padding: 2.5rem 1.5rem;
    }

    .logo-strip__label {
      margin-bottom: 1.5rem;
    }

    .logo-strip__inner {
      gap: 2rem;
    }

    .logo-strip__img {
      height: 18px;
    }

    .statement {
      padding: 6rem 1.5rem;
      min-height: auto;
    }

    .statement__text {
      font-size: clamp(1.3rem, 5vw, 2rem);
    }

    .affiliations {
      padding: 0 1.5rem 5rem;
    }

    .panel {
      padding: 2rem 1.5rem;
      gap: 1rem;
    }

    .panel__title {
      font-size: 1.4rem;
    }

    .panel__desc {
      display: none;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";
  import { CustomEase } from "gsap/CustomEase";

  // Corpus injected from YAML at build time, with static fallbacks
  const corpus = (window as any).__HERO_CORPUS__ || {};
  const CODE_FRAGMENTS: string[] = corpus.code || [];
  const PUBLICATION_FRAGMENTS: string[] = corpus.publications || [];
  const KEYWORDS: string[] = corpus.keywords || [];
  const ENTITIES: string[] = [...(corpus.orgs || []), ...(corpus.events || []).slice(0, 15)];
  const DATA_VALUES: string[] = corpus.data || [];
  const PROJECT_NAMES: string[] = corpus.projects || [];

  gsap.registerPlugin(ScrollTrigger, SplitText, CustomEase);
  CustomEase.create("smooth", "M0,0 C0.22,0.61 0.36,1 0.59,1 0.68,1 0.82,0.98 1,1");

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const heroSection = document.getElementById("hero") as HTMLElement;
  const heroMode = heroSection?.dataset.heroMode || "terminal";
  const canvas = document.getElementById("hero-canvas") as HTMLCanvasElement;
  const ctx = canvas?.getContext("2d");
  const pointer = { x: -9999, y: -9999, active: false, strength: 1 };

  // ========================================
  // SHARED — Color palette
  // ========================================
  const COLORS = {
    blue:   { r: 37, g: 99, b: 235 },
    teal:   { r: 13, g: 148, b: 136 },
    violet: { r: 124, g: 58, b: 237 },
    warm:   { r: 232, g: 93, b: 4 },
    dim:    { r: 60, g: 60, b: 80 },
  };
  const COLOR_KEYS = Object.keys(COLORS) as (keyof typeof COLORS)[];

  function rgba(c: {r:number,g:number,b:number}, a: number) {
    return `rgba(${c.r},${c.g},${c.b},${a})`;
  }

  // ========================================
  // SHARED — Pointer events (mouse + touch)
  // ========================================
  function setupPointer(el: HTMLElement | null) {
    if (!el || !canvas) return;
    el.addEventListener("mousemove", (e) => {
      const r = canvas.getBoundingClientRect();
      pointer.x = e.clientX - r.left;
      pointer.y = e.clientY - r.top;
      pointer.active = true;
      pointer.strength = 1;
    });
    el.addEventListener("mouseleave", () => {
      pointer.active = false; pointer.x = -9999; pointer.y = -9999;
    });
    el.addEventListener("touchstart", (e) => {
      const r = canvas.getBoundingClientRect();
      const t = e.touches[0];
      pointer.x = t.clientX - r.left;
      pointer.y = t.clientY - r.top;
      pointer.active = true;
      pointer.strength = 1.5;
    }, { passive: true });
    el.addEventListener("touchmove", (e) => {
      const r = canvas.getBoundingClientRect();
      const t = e.touches[0];
      pointer.x = t.clientX - r.left;
      pointer.y = t.clientY - r.top;
      pointer.active = true;
    }, { passive: true });
    el.addEventListener("touchend", () => {
      pointer.active = false; pointer.x = -9999; pointer.y = -9999;
    });
  }

  // ========================================
  // CONCEPT A: "THE TERMINAL"
  //
  // A dark canvas resembling a live investigation feed.
  // Real code fragments, publication titles, keywords
  // stream upward in monospace. Lines get "processed":
  // highlighted, tagged with colored labels.
  // Touch/mouse creates a query burst — nearby text
  // converges toward the pointer like a search filter.
  // ========================================
  function initTerminal() {
    if (!canvas || !ctx) return;

    // Build the feed pool — mix all corpus categories with type tags
    interface FeedLine {
      text: string;
      type: "code" | "pub" | "keyword" | "entity" | "data";
      color: keyof typeof COLORS;
    }

    function buildPool(): FeedLine[] {
      const pool: FeedLine[] = [];
      CODE_FRAGMENTS.forEach(t => pool.push({ text: t, type: "code", color: "teal" }));
      PUBLICATION_FRAGMENTS.forEach(t => pool.push({ text: t, type: "pub", color: "violet" }));
      KEYWORDS.forEach(t => pool.push({ text: `[${t}]`, type: "keyword", color: "blue" }));
      ENTITIES.forEach(t => pool.push({ text: t, type: "entity", color: "warm" }));
      DATA_VALUES.forEach(t => pool.push({ text: t, type: "data", color: "dim" }));
      PROJECT_NAMES.forEach(t => pool.push({ text: t, type: "pub", color: "teal" }));
      return pool;
    }

    const pool = buildPool();
    function pickRandom(): FeedLine {
      return pool[Math.floor(Math.random() * pool.length)];
    }

    // Active lines on screen
    interface ActiveLine {
      feed: FeedLine;
      x: number;
      y: number;
      targetY: number;
      speed: number;
      alpha: number;
      targetAlpha: number;
      charReveal: number;    // how many chars visible (typewriter)
      revealSpeed: number;
      highlighted: boolean;  // "processed" state
      highlightTime: number;
      fontSize: number;
      born: number;
    }

    let lines: ActiveLine[] = [];
    let frameCount = 0;
    const DPR = Math.min(window.devicePixelRatio || 1, 2);

    function resize() {
      canvas.width = canvas.offsetWidth * DPR;
      canvas.height = canvas.offsetHeight * DPR;
      ctx!.scale(DPR, DPR);
    }

    // Spawn a new line at the bottom
    function spawnLine(): ActiveLine {
      const w = canvas.offsetWidth;
      const h = canvas.offsetHeight;
      const feed = pickRandom();
      const fontSize = feed.type === "code" ? 11 + Math.random() * 3 :
                       feed.type === "keyword" ? 10 + Math.random() * 2 :
                       feed.type === "data" ? 9 + Math.random() * 2 :
                       12 + Math.random() * 4;
      return {
        feed,
        x: 20 + Math.random() * (w - 200),
        y: h + 20 + Math.random() * 60,
        targetY: -50,
        speed: 0.15 + Math.random() * 0.35,
        alpha: 0,
        targetAlpha: 0.15 + Math.random() * 0.25,
        charReveal: 0,
        revealSpeed: 0.3 + Math.random() * 0.7,
        highlighted: false,
        highlightTime: 0,
        fontSize,
        born: frameCount,
      };
    }

    // Determine how many lines to keep alive based on viewport
    const w = canvas.offsetWidth;
    const h = canvas.offsetHeight;
    const maxLines = Math.min(60, Math.max(15, Math.floor((w * h) / 25000)));
    const spawnInterval = Math.max(8, Math.floor(60 / maxLines * 5));

    // Pre-populate with scattered lines
    for (let i = 0; i < Math.floor(maxLines * 0.6); i++) {
      const line = spawnLine();
      line.y = Math.random() * h;
      line.charReveal = line.feed.text.length;
      line.alpha = line.targetAlpha;
      lines.push(line);
    }

    function tick() {
      if (!ctx) return;
      const W = canvas.offsetWidth;
      const H = canvas.offsetHeight;

      // Clear with trail
      ctx.fillStyle = "rgba(6, 6, 10, 0.12)";
      ctx.fillRect(0, 0, W, H);

      frameCount++;

      // Spawn new lines periodically
      if (frameCount % spawnInterval === 0 && lines.length < maxLines) {
        lines.push(spawnLine());
      }

      // Randomly highlight a line (simulate "processing")
      if (frameCount % 90 === 0) {
        const candidates = lines.filter(l => !l.highlighted && l.charReveal >= l.feed.text.length * 0.8);
        if (candidates.length > 0) {
          const pick = candidates[Math.floor(Math.random() * candidates.length)];
          pick.highlighted = true;
          pick.highlightTime = 0;
          pick.targetAlpha = 0.7 + Math.random() * 0.3;
        }
      }

      for (let i = lines.length - 1; i >= 0; i--) {
        const line = lines[i];

        // Movement — scroll upward
        line.y -= line.speed;

        // Pointer attraction — touch/mouse pulls nearby lines
        if (pointer.active) {
          const dx = pointer.x - line.x;
          const dy = pointer.y - line.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          const radius = 250;
          if (dist < radius && dist > 0) {
            const pull = ((radius - dist) / radius) * 0.4 * pointer.strength;
            line.x += (dx / dist) * pull;
            line.y += (dy / dist) * pull * 0.3;
            // Boost visibility near pointer
            line.targetAlpha = Math.min(1, line.targetAlpha + 0.3);
            if (!line.highlighted && dist < 100) {
              line.highlighted = true;
              line.highlightTime = 0;
            }
          }
        }

        // Typewriter reveal
        if (line.charReveal < line.feed.text.length) {
          line.charReveal += line.revealSpeed;
        }

        // Alpha easing
        line.alpha += (line.targetAlpha - line.alpha) * 0.04;

        // Fade out near top
        if (line.y < 80) {
          line.alpha *= line.y / 80;
        }

        // Remove offscreen
        if (line.y < -50 || line.alpha < 0.005) {
          lines.splice(i, 1);
          continue;
        }

        // Highlight decay
        if (line.highlighted) {
          line.highlightTime++;
          if (line.highlightTime > 120) {
            line.targetAlpha = Math.max(0.1, line.targetAlpha - 0.01);
          }
        }

        // Draw
        const c = COLORS[line.feed.color];
        const visibleText = line.feed.text.slice(0, Math.floor(line.charReveal));

        ctx.font = `${line.fontSize}px 'JetBrains Mono', 'Fira Code', monospace`;

        if (line.highlighted && line.highlightTime < 180) {
          // Highlighted: draw background tag + brighter text
          const metrics = ctx.measureText(visibleText);
          const tagH = line.fontSize + 6;
          const tagW = metrics.width + 12;

          ctx.fillStyle = rgba(c, line.alpha * 0.15);
          ctx.fillRect(line.x - 4, line.y - line.fontSize + 1, tagW, tagH);

          // Left accent bar
          ctx.fillStyle = rgba(c, line.alpha * 0.8);
          ctx.fillRect(line.x - 4, line.y - line.fontSize + 1, 2, tagH);

          ctx.fillStyle = rgba(c, line.alpha);
          ctx.fillText(visibleText, line.x + 2, line.y + 2);

          // Tag label for certain types
          if (line.feed.type === "keyword" || line.feed.type === "data") {
            const label = line.feed.type === "keyword" ? "TAG" : "VAL";
            ctx.font = `9px 'JetBrains Mono', monospace`;
            ctx.fillStyle = rgba(c, line.alpha * 0.5);
            ctx.fillText(label, line.x + tagW + 6, line.y + 2);
          }
        } else {
          // Normal dim text
          ctx.fillStyle = rgba(c, line.alpha);
          ctx.fillText(visibleText, line.x, line.y);
        }

        // Cursor blink while typing
        if (line.charReveal < line.feed.text.length) {
          const partial = ctx.measureText(visibleText);
          if (Math.floor(frameCount / 20) % 2 === 0) {
            ctx.fillStyle = rgba(c, line.alpha * 1.5);
            ctx.fillRect(line.x + partial.width + 1, line.y - line.fontSize + 4, 1.5, line.fontSize);
          }
        }
      }

      // Scanline effect — subtle horizontal lines
      ctx.fillStyle = "rgba(255,255,255,0.008)";
      for (let sy = 0; sy < H; sy += 3) {
        ctx.fillRect(0, sy, W, 1);
      }

      requestAnimationFrame(tick);
    }

    resize();
    tick();
    window.addEventListener("resize", resize);
    setupPointer(canvas.parentElement);
  }

  // ========================================
  // CONCEPT B: "SIGNAL DETECTION" v2
  //
  // Chaotic but subtle. Multiple noise layers
  // create a restless interference field. Text
  // fragments drift and jitter, barely emerging
  // before dissolving. Random glitch bursts tear
  // across the canvas. Pointer creates a calm
  // clarity zone amidst the chaos.
  // YAML-sourced: real publication titles, events,
  // orgs, code, all pulled at build time.
  // ========================================
  function initSignal() {
    if (!canvas || !ctx) return;

    const DPR = Math.min(window.devicePixelRatio || 1, 2);
    let frameCount = 0;

    // All text sources combined — weighted toward real YAML content
    const ALL_TEXT = [
      ...PUBLICATION_FRAGMENTS,
      ...PUBLICATION_FRAGMENTS.filter(() => Math.random() > 0.5), // double weight pubs
      ...ENTITIES,
      ...PROJECT_NAMES,
      ...CODE_FRAGMENTS,
      ...KEYWORDS.map(k => `[${k}]`),
      ...DATA_VALUES,
    ];

    function resize() {
      canvas.width = canvas.offsetWidth * DPR;
      canvas.height = canvas.offsetHeight * DPR;
      ctx!.scale(DPR, DPR);
    }

    // ── Noise layer: ImageData-based static ──
    // Much faster than individual fillRects — renders thousands of pixels via buffer
    let noiseImageData: ImageData | null = null;

    function renderNoise(W: number, H: number) {
      if (!ctx) return;
      if (!noiseImageData || noiseImageData.width !== W * DPR || noiseImageData.height !== H * DPR) {
        noiseImageData = ctx.createImageData(W, H);
      }
      const data = noiseImageData.data;
      const len = data.length;
      // Only update ~20% of pixels per frame for shimmer
      for (let i = 0; i < len; i += 4) {
        if (Math.random() > 0.2) continue;
        const bright = Math.random() * 35;
        // Occasional color tint
        if (Math.random() < 0.008) {
          const ck = COLOR_KEYS[Math.floor(Math.random() * (COLOR_KEYS.length - 1))]; // skip 'dim'
          const c = COLORS[ck];
          data[i] = c.r * 0.4;
          data[i + 1] = c.g * 0.4;
          data[i + 2] = c.b * 0.4;
          data[i + 3] = 12 + Math.random() * 20;
        } else {
          data[i] = bright;
          data[i + 1] = bright;
          data[i + 2] = bright + 5;
          data[i + 3] = Math.random() * 10;
        }
      }
      ctx.putImageData(noiseImageData, 0, 0);
    }

    // ── Glitch tears — horizontal displacement bursts ──
    interface GlitchTear {
      y: number;
      height: number;
      offset: number;
      life: number;
      maxLife: number;
      colorKey: keyof typeof COLORS;
    }
    let glitches: GlitchTear[] = [];

    function maybeSpawnGlitch(H: number) {
      // Random bursts — more frequent = more chaotic
      if (Math.random() < 0.03) {
        const count = 1 + Math.floor(Math.random() * 3);
        for (let i = 0; i < count; i++) {
          glitches.push({
            y: Math.random() * H,
            height: 1 + Math.random() * 4,
            offset: (Math.random() - 0.5) * 30,
            life: 0,
            maxLife: 3 + Math.floor(Math.random() * 8),
            colorKey: COLOR_KEYS[Math.floor(Math.random() * (COLOR_KEYS.length - 1))],
          });
        }
      }
    }

    // ── Text fragments ──
    interface SignalFragment {
      text: string;
      x: number;
      y: number;
      fontSize: number;
      colorKey: keyof typeof COLORS;
      phase: "emerging" | "visible" | "dissolving" | "dead";
      phaseTime: number;
      emergeDuration: number;
      visibleDuration: number;
      dissolveDuration: number;
      charStates: number[];
      driftX: number;  // slow horizontal drift
      driftY: number;  // slow vertical drift
      jitter: number;  // per-frame position noise intensity
    }

    const NOISE_CHARS = "▓▒░█▄▀─│┼╳·.,:;'\"_-+~<>{}()[]";

    let fragments: SignalFragment[] = [];

    function spawnFragment(): SignalFragment {
      const W = canvas.offsetWidth;
      const H = canvas.offsetHeight;
      const text = ALL_TEXT[Math.floor(Math.random() * ALL_TEXT.length)];
      const fontSize = 9 + Math.random() * 6; // smaller = subtler
      const colorKey = COLOR_KEYS[Math.floor(Math.random() * (COLOR_KEYS.length - 1))]; // skip 'dim'

      return {
        text,
        x: 20 + Math.random() * (W - 180),
        y: 30 + Math.random() * (H - 60),
        fontSize,
        colorKey,
        phase: "emerging",
        phaseTime: 0,
        emergeDuration: 60 + Math.random() * 90,   // slower emerge
        visibleDuration: 30 + Math.random() * 60,   // brief visibility
        dissolveDuration: 40 + Math.random() * 70,  // slow dissolve
        charStates: new Array(text.length).fill(0),
        driftX: (Math.random() - 0.5) * 0.15,
        driftY: (Math.random() - 0.5) * 0.08,
        jitter: 0.3 + Math.random() * 0.5,
      };
    }

    const W0 = canvas.offsetWidth;
    const H0 = canvas.offsetHeight;
    const maxFragments = Math.min(25, Math.max(6, Math.floor((W0 * H0) / 45000)));
    const spawnRate = Math.max(10, Math.floor(50 / maxFragments * 3));

    function tick() {
      if (!ctx) return;
      const W = canvas.offsetWidth;
      const H = canvas.offsetHeight;

      // ── Layer 1: dark base with very slight persistence ──
      ctx.fillStyle = "rgba(6, 6, 10, 0.85)";
      ctx.fillRect(0, 0, W, H);

      frameCount++;

      // ── Layer 2: pixel noise ──
      renderNoise(W, H);

      // ── Layer 3: glitch tears ──
      maybeSpawnGlitch(H);
      for (let i = glitches.length - 1; i >= 0; i--) {
        const g = glitches[i];
        g.life++;
        if (g.life > g.maxLife) { glitches.splice(i, 1); continue; }
        const c = COLORS[g.colorKey];
        const a = 0.06 * (1 - g.life / g.maxLife);
        ctx.fillStyle = rgba(c, a);
        ctx.fillRect(g.offset > 0 ? 0 : W + g.offset, g.y, Math.abs(g.offset), g.height);
        // Also draw a thin bright line
        ctx.fillStyle = rgba(c, a * 3);
        ctx.fillRect(0, g.y, W, 0.5);
      }

      // ── Spawn fragments ──
      if (frameCount % spawnRate === 0 && fragments.filter(f => f.phase !== "dead").length < maxFragments) {
        fragments.push(spawnFragment());
      }

      // ── Clarity zone near pointer ──
      let clarityX = -9999, clarityY = -9999, clarityRadius = 0;
      if (pointer.active) {
        clarityX = pointer.x;
        clarityY = pointer.y;
        clarityRadius = 180 * pointer.strength;

        // Very subtle glow
        const grad = ctx.createRadialGradient(clarityX, clarityY, 0, clarityX, clarityY, clarityRadius);
        grad.addColorStop(0, "rgba(13, 148, 136, 0.03)");
        grad.addColorStop(1, "transparent");
        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.arc(clarityX, clarityY, clarityRadius, 0, Math.PI * 2);
        ctx.fill();
      }

      // ── Update and draw fragments ──
      for (let i = fragments.length - 1; i >= 0; i--) {
        const frag = fragments[i];
        if (frag.phase === "dead") { fragments.splice(i, 1); continue; }

        frag.phaseTime++;

        // Drift
        frag.x += frag.driftX;
        frag.y += frag.driftY;

        // Clarity check
        const dx = clarityX - frag.x;
        const dy = clarityY - frag.y;
        const distToPointer = Math.sqrt(dx * dx + dy * dy);
        const inClarity = distToPointer < clarityRadius;
        const clarityBoost = inClarity ? 2 * (1 - distToPointer / clarityRadius) : 0;

        // Phase transitions
        if (frag.phase === "emerging" && frag.phaseTime > frag.emergeDuration * (inClarity ? 0.25 : 1)) {
          frag.phase = "visible"; frag.phaseTime = 0;
        } else if (frag.phase === "visible" && frag.phaseTime > frag.visibleDuration) {
          frag.phase = "dissolving"; frag.phaseTime = 0;
        } else if (frag.phase === "dissolving" && frag.phaseTime > frag.dissolveDuration) {
          frag.phase = "dead"; continue;
        }

        // Character reveal — non-linear, random per-char
        const revealProgress =
          frag.phase === "emerging" ? frag.phaseTime / frag.emergeDuration :
          frag.phase === "visible" ? 1 :
          1 - (frag.phaseTime / frag.dissolveDuration);
        const boosted = Math.min(1, revealProgress + clarityBoost * 0.4);

        for (let ci = 0; ci < frag.charStates.length; ci++) {
          // Random reveal order — not strictly left-to-right
          const threshold = (Math.sin(ci * 2.7 + frag.x * 0.01) + 1) * 0.5;
          if (frag.phase === "dissolving") {
            frag.charStates[ci] = revealProgress > threshold * 0.7 ? 1 : 0;
          } else {
            frag.charStates[ci] = boosted > threshold ? 1 : 0;
          }
        }

        // Alpha — very subtle overall
        let alpha: number;
        if (frag.phase === "emerging") {
          alpha = 0.08 + boosted * 0.25;
        } else if (frag.phase === "visible") {
          alpha = 0.25 + (inClarity ? 0.45 : 0.1);
        } else {
          alpha = Math.max(0, 0.3 * revealProgress);
        }

        // Jitter
        const jx = (Math.random() - 0.5) * frag.jitter;
        const jy = (Math.random() - 0.5) * frag.jitter * 0.5;

        // Draw characters
        const c = COLORS[frag.colorKey];
        ctx.font = `${frag.fontSize}px 'JetBrains Mono', 'Fira Code', monospace`;

        let cursorX = frag.x + jx;
        const drawY = frag.y + jy;

        for (let ci = 0; ci < frag.text.length; ci++) {
          const revealed = frag.charStates[ci] === 1;
          const char = revealed ? frag.text[ci] :
                       NOISE_CHARS[Math.floor(Math.random() * NOISE_CHARS.length)];

          if (revealed) {
            ctx.fillStyle = rgba(c, alpha);
          } else {
            ctx.fillStyle = rgba(COLORS.dim, alpha * 0.2);
          }

          // Occasional per-char glitch offset
          const charJitter = (!revealed && Math.random() < 0.05) ? (Math.random() - 0.5) * 3 : 0;
          ctx.fillText(char, cursorX + charJitter, drawY);
          cursorX += ctx.measureText(frag.text[ci]).width;
        }
      }

      // ── Scan lines — multiple, varying speeds ──
      const scan1 = (frameCount * 0.3) % H;
      const scan2 = (frameCount * 0.7 + H * 0.6) % H;
      ctx.fillStyle = "rgba(13, 148, 136, 0.015)";
      ctx.fillRect(0, scan1, W, 1);
      ctx.fillStyle = "rgba(124, 58, 237, 0.01)";
      ctx.fillRect(0, scan2, W, 1);

      // ── Vignette — heavier for subtlety ──
      const vig = ctx.createRadialGradient(W / 2, H / 2, H * 0.25, W / 2, H / 2, H * 0.85);
      vig.addColorStop(0, "transparent");
      vig.addColorStop(1, "rgba(6, 6, 10, 0.55)");
      ctx.fillStyle = vig;
      ctx.fillRect(0, 0, W, H);

      requestAnimationFrame(tick);
    }

    resize();
    tick();
    window.addEventListener("resize", resize);
    setupPointer(canvas.parentElement);
  }

  // ========================================
  // INIT — launch the selected hero mode
  // ========================================
  if (canvas && ctx && !reducedMotion) {
    if (heroMode === "terminal") {
      initTerminal();
    } else {
      initSignal();
    }
  } else if (canvas && ctx) {
    // Reduced motion fallback — static scattered text
    const DPR = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = canvas.offsetWidth * DPR;
    canvas.height = canvas.offsetHeight * DPR;
    ctx.scale(DPR, DPR);
    const W = canvas.offsetWidth, H = canvas.offsetHeight;
    ctx.fillStyle = "#06060a";
    ctx.fillRect(0, 0, W, H);

    const allText = [...CODE_FRAGMENTS, ...PUBLICATION_FRAGMENTS.slice(0, 20), ...KEYWORDS.map(k => `[${k}]`), ...DATA_VALUES, ...PROJECT_NAMES];
    ctx.font = "11px 'JetBrains Mono', monospace";
    for (let i = 0; i < 40; i++) {
      const t = allText[Math.floor(Math.random() * allText.length)];
      const ck = COLOR_KEYS[Math.floor(Math.random() * COLOR_KEYS.length)];
      const c = COLORS[ck];
      ctx.fillStyle = rgba(c, 0.1 + Math.random() * 0.15);
      ctx.fillText(t, 20 + Math.random() * (W - 200), 30 + Math.random() * (H - 60));
    }
  }

  // ========================================
  // HERO ENTRANCE — bold, immediate
  // ========================================
  if (!reducedMotion) {
    const catchEl = document.getElementById("hero-catchphrase") as HTMLElement;
    const phrase = "Finding signal in the noise";

    catchEl.textContent = "";
    gsap.set(catchEl, { opacity: 1 });

    const heroTl = gsap.timeline({ delay: 0.3 });

    // Type the catchphrase
    let charIndex = 0;
    heroTl.to({}, {
      duration: phrase.length * 0.05,
      ease: "none",
      onUpdate: function() {
        const progress = this.progress();
        const newIndex = Math.floor(progress * phrase.length);
        if (newIndex > charIndex) {
          charIndex = newIndex;
          catchEl.textContent = phrase.slice(0, charIndex);
        }
      },
      onComplete: () => { catchEl.textContent = phrase; }
    });

    heroTl.add(() => catchEl.classList.add("typing-done"), "+=0.3");

    // Name — slam in from below, pure white, unmissable
    heroTl.to("#hero-name", {
      opacity: 1, y: 0, duration: 1.0,
      ease: "power4.out",
    }, "+=0.1");

    // Catchphrase fades subtle
    heroTl.to(catchEl, {
      color: "rgba(248, 247, 244, 0.2)",
      textShadow: "none",
      duration: 1.0,
      ease: "power2.out",
    }, "<+0.3");

    // Scroll indicator
    heroTl.to("#hero-scroll", {
      opacity: 1, duration: 1.0, ease: "power2.out"
    }, "-=0.3");

    // Parallax on scroll
    ScrollTrigger.create({
      trigger: ".hero",
      start: "top top",
      end: "bottom top",
      scrub: true,
      onUpdate: (self) => {
        const p = self.progress;
        gsap.set(".hero__content", { y: p * 150, opacity: 1 - p * 2 });
        gsap.set("#hero-scroll", { opacity: Math.max(0, 1 - p * 5) });
      },
    });

    const navBar = document.querySelector('.nav-bar');
    if (navBar) {
      ScrollTrigger.create({
        trigger: '.hero',
        start: 'bottom 80px',
        onEnter: () => navBar.classList.add('nav--visible'),
        onLeaveBack: () => navBar.classList.remove('nav--visible'),
      });
    }
  } else {
    const catchEl = document.getElementById("hero-catchphrase") as HTMLElement;
    catchEl.classList.add("typing-done");
    gsap.set("#hero-catchphrase, #hero-name, #hero-scroll", { opacity: 1 });
    gsap.set("#hero-name", { y: 0 });

    const navBar = document.querySelector('.nav-bar');
    if (navBar) {
      ScrollTrigger.create({
        trigger: '.hero',
        start: 'bottom 80px',
        onEnter: () => navBar.classList.add('nav--visible'),
        onLeaveBack: () => navBar.classList.remove('nav--visible'),
      });
    }
  }

  // ========================================
  // STATEMENT — per-word scroll color reveal
  // ========================================
  const stEl = document.getElementById("statement-1");
  if (stEl && !reducedMotion) {
    const split = SplitText.create(stEl, { type: "words" });
    split.words.forEach((w: HTMLElement) => w.classList.add("char-dim"));

    ScrollTrigger.create({
      trigger: ".statement",
      start: "top 70%",
      end: "bottom 40%",
      scrub: true,
      onUpdate: (self) => {
        const progress = self.progress;
        split.words.forEach((w: HTMLElement, i: number) => {
          const wordProgress = i / split.words.length;
          w.style.color = progress > wordProgress ? "var(--ink)" : "";
        });
      },
    });
  }

  // ========================================
  // PANEL REVEALS — staggered entrance
  // ========================================
  if (!reducedMotion) {
    gsap.utils.toArray<HTMLElement>(".panel").forEach((panel, i) => {
      gsap.from(panel, {
        y: 40, opacity: 0,
        duration: 0.7,
        delay: i * 0.1,
        ease: "power3.out",
        scrollTrigger: {
          trigger: panel,
          start: "top 92%",
          once: true,
        },
      });
    });
  }
</script>
