---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Adriano Belisario" description="Data journalist & researcher. Oxford, UNHCR, Bellingcat, Forensic Architecture." hideNavInitially={true}>

  <!-- ========== HERO ========== -->
  <section class="hero" id="hero">
    <canvas id="flow-canvas" aria-hidden="true"></canvas>
    <div class="hero__grain" aria-hidden="true"></div>

    <div class="hero__content">
      <p class="hero__catchphrase mono" id="hero-catchphrase">Finding signal in the noise</p>
      <h1 class="hero__name" id="hero-name" aria-label="Adriano Belisario">
        <span class="hero__line" id="line-1">Adriano</span>
        <span class="hero__line" id="line-2">Belisario</span>
      </h1>
    </div>

    <div class="hero__scroll" id="hero-scroll">
      <div class="hero__scroll-line"><span></span></div>
    </div>
  </section>

  <!-- ========== STATEMENT ========== -->
  <section class="statement">
    <div class="statement__inner">
      <p class="statement__text" id="statement-1">
        Combining expertise in communication, open&#8209;source technologies,
        and data to address important social concerns.
      </p>
    </div>
  </section>

  <!-- ========== AFFILIATIONS ========== -->
  <section class="affiliations">
    <div class="affiliations__inner">
      <p class="affiliations__text reveal">
        Currently collaborating with the
        <a href="https://www.jointdatacenter.org/">Joint Data Center on Forced Displacement</a>
        and <a href="https://netlab.eco.ufrj.br/">Netlab/UFRJ</a>.
        MSc in Social Data Science,
        <strong>Oxford Internet Institute</strong>.
      </p>
    </div>
  </section>

  <!-- ========== NAVIGATION PANELS ========== -->
  <section class="panels">
    <a href="/code/" class="panel" data-color="teal">
      <canvas class="panel__canvas" aria-hidden="true"></canvas>
      <span class="panel__index mono">01</span>
      <div class="panel__body">
        <h2 class="panel__title">Code</h2>
        <p class="panel__desc">Data projects & code — NLP, geodata, network analysis, machine learning.</p>
      </div>
      <span class="panel__arrow">&rarr;</span>
    </a>
    <a href="/publications/" class="panel" data-color="violet">
      <canvas class="panel__canvas" aria-hidden="true"></canvas>
      <span class="panel__index mono">02</span>
      <div class="panel__body">
        <h2 class="panel__title">Publications</h2>
        <p class="panel__desc">Academic papers, investigations, books & tutorials in English & Portuguese.</p>
      </div>
      <span class="panel__arrow">&rarr;</span>
    </a>
    <a href="/events/" class="panel" data-color="warm">
      <canvas class="panel__canvas" aria-hidden="true"></canvas>
      <span class="panel__index mono">03</span>
      <div class="panel__body">
        <h2 class="panel__title">Events</h2>
        <p class="panel__desc">Conferences, lectures, workshops & courses across four continents.</p>
      </div>
      <span class="panel__arrow">&rarr;</span>
    </a>
    <a href="/about/" class="panel" data-color="blue">
      <canvas class="panel__canvas" aria-hidden="true"></canvas>
      <span class="panel__index mono">04</span>
      <div class="panel__body">
        <h2 class="panel__title">About</h2>
        <p class="panel__desc">CV, education, professional experience & collaborations.</p>
      </div>
      <span class="panel__arrow">&rarr;</span>
    </a>
  </section>

  <!-- ========== LOGO STRIP ========== -->
  <section class="logo-strip">
    <p class="logo-strip__label mono">Collaborated with</p>
    <div class="logo-strip__inner">
      <img src="/images/logos/oxford.svg" alt="Oxford" class="logo-strip__img" />
      <img src="/images/logos/unhcr.svg" alt="UNHCR" class="logo-strip__img" />
      <img src="/images/logos/bellingcat.svg" alt="Bellingcat" class="logo-strip__img" />
      <img src="/images/logos/forensic-architecture.svg" alt="Forensic Architecture" class="logo-strip__img" />
      <img src="/images/logos/agencia-publica.svg" alt="Agência Pública" class="logo-strip__img" />
    </div>
  </section>

</BaseLayout>

<style>
  /* ============================
     HERO — Generative Flow Field
     ============================ */
  .hero {
    position: relative;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-left: calc(-50vw + 50%);
    background: #06060a;
  }

  #flow-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero__grain {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    background-repeat: repeat;
    z-index: 1;
    pointer-events: none;
    opacity: 0.4;
    mix-blend-mode: overlay;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 1.5rem;
  }

  .hero__catchphrase {
    font-size: clamp(0.8rem, 2.5vw, 1.2rem);
    letter-spacing: 0.15em;
    color: var(--signal-teal);
    margin-bottom: 2rem;
    opacity: 0;
    text-shadow: 0 0 40px rgba(13, 148, 136, 0.4);
  }

  .hero__catchphrase::after {
    content: '|';
    animation: cursorBlink 0.8s step-end infinite;
    color: var(--signal-teal);
    margin-left: 2px;
    font-weight: 300;
  }

  .hero__catchphrase.typing-done::after {
    display: none;
  }

  @keyframes cursorBlink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* Name — massive, bright white, unmissable on any screen */
  .hero__name {
    font-size: clamp(4rem, 18vw, 14rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.88;
    margin: 0;
    color: #ffffff;
    opacity: 0;
    transform: translateY(30px);
  }

  .hero__line {
    display: block;
    will-change: transform, opacity;
  }

  /* Scroll indicator */
  .hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    opacity: 0;
  }

  .hero__scroll-line span {
    display: block;
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, rgba(13, 148, 136, 0.6), transparent);
    animation: linePulse 2.5s ease-in-out infinite;
  }

  @keyframes linePulse {
    0%, 100% { transform: scaleY(0.3); opacity: 0.2; transform-origin: top; }
    50% { transform: scaleY(1); opacity: 0.8; transform-origin: top; }
  }

  /* ============================
     LOGO STRIP
     ============================ */
  .logo-strip {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    background: #f0eeeb;
    padding: 4rem 2rem;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  .logo-strip__label {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-tertiary);
    margin: 0 0 2rem;
  }

  .logo-strip__inner {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3.5rem;
    flex-wrap: wrap;
  }

  .logo-strip__img {
    height: 22px;
    opacity: 0.4;
    filter: grayscale(1);
    transition: opacity 0.4s ease, filter 0.4s ease;
  }

  .logo-strip__img:hover {
    opacity: 0.8;
    filter: grayscale(0);
  }

  /* ============================
     STATEMENT
     ============================ */
  .statement {
    padding: 10rem 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    background: #ffffff;
  }

  .statement__inner {
    max-width: 900px;
  }

  .statement__text {
    font-size: clamp(1.5rem, 4vw, 3rem);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  :global(.statement__text .char-dim) {
    color: var(--ink-tertiary);
    transition: color 0.3s ease;
  }

  /* ============================
     AFFILIATIONS
     ============================ */
  .affiliations {
    padding: 0 2rem 8rem;
    background: #ffffff;
  }

  .affiliations__inner {
    max-width: 700px;
    margin: 0 auto;
  }

  .affiliations__text {
    font-size: 1.1rem;
    line-height: 2;
    color: var(--ink-secondary);
    margin-bottom: 2rem;
  }

  /* ============================
     PANELS — with generative canvases
     ============================ */
  .panels {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    border-top: 1px solid var(--border);
    background: #ffffff;
  }

  .panel {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 2.5rem 3rem;
    text-decoration: none;
    color: var(--ink);
    border-bottom: 1px solid var(--border);
    position: relative;
    overflow: hidden;
    transition: all 0.4s ease;
  }

  .panel__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  .panel__index, .panel__body, .panel__arrow {
    position: relative;
    z-index: 1;
  }

  .panel__index {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    color: var(--ink-tertiary);
    flex-shrink: 0;
    width: 2rem;
    transition: color 0.3s ease;
  }

  .panel__body {
    flex: 1;
  }

  .panel__title {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 0.25rem;
    line-height: 1.1;
    color: var(--ink);
    transition: color 0.3s ease;
  }

  .panel__desc {
    font-size: 0.85rem;
    color: var(--ink-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .panel__arrow {
    font-size: 1.5rem;
    color: var(--ink-tertiary);
    flex-shrink: 0;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .panel:hover .panel__arrow {
    transform: translateX(8px);
  }

  /* Per-color hover tints */
  .panel[data-color="teal"]:hover .panel__title,
  .panel[data-color="teal"]:hover .panel__arrow,
  .panel[data-color="teal"]:hover .panel__index { color: var(--signal-teal); }

  .panel[data-color="violet"]:hover .panel__title,
  .panel[data-color="violet"]:hover .panel__arrow,
  .panel[data-color="violet"]:hover .panel__index { color: var(--signal-violet); }

  .panel[data-color="warm"]:hover .panel__title,
  .panel[data-color="warm"]:hover .panel__arrow,
  .panel[data-color="warm"]:hover .panel__index { color: var(--signal-warm); }

  .panel[data-color="blue"]:hover .panel__title,
  .panel[data-color="blue"]:hover .panel__arrow,
  .panel[data-color="blue"]:hover .panel__index { color: var(--signal-primary); }

  /* ============================
     RESPONSIVE
     ============================ */
  @media screen and (max-width: 768px) {
    .hero__name {
      font-size: clamp(3.2rem, 18vw, 6rem);
    }

    .hero__catchphrase {
      font-size: clamp(0.7rem, 3.5vw, 0.95rem);
      margin-bottom: 1.2rem;
    }

    .logo-strip {
      padding: 2.5rem 1.5rem;
    }

    .logo-strip__label {
      margin-bottom: 1.5rem;
    }

    .logo-strip__inner {
      gap: 2rem;
    }

    .logo-strip__img {
      height: 18px;
    }

    .statement {
      padding: 6rem 1.5rem;
      min-height: auto;
    }

    .statement__text {
      font-size: clamp(1.3rem, 5vw, 2rem);
    }

    .affiliations {
      padding: 0 1.5rem 5rem;
    }

    .panel {
      padding: 2rem 1.5rem;
      gap: 1rem;
    }

    .panel__title {
      font-size: 1.4rem;
    }

    .panel__desc {
      display: none;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";
  import { CustomEase } from "gsap/CustomEase";

  gsap.registerPlugin(ScrollTrigger, SplitText, CustomEase);
  CustomEase.create("smooth", "M0,0 C0.22,0.61 0.36,1 0.59,1 0.68,1 0.82,0.98 1,1");

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ========================================
  // HERO — Generative Flow Field
  //
  // Perlin-style noise drives a vector field.
  // Hundreds of particles trace autonomous paths
  // through the field, leaving colored trails.
  // Always moving — mobile-first, no mouse needed.
  // Mouse adds gravitational pull as a bonus.
  // ========================================
  const heroCanvas = document.getElementById("flow-canvas") as HTMLCanvasElement;
  const heroCtx = heroCanvas?.getContext("2d");

  // Hash-based value noise
  function noise2D(x: number, y: number): number {
    const n = Math.sin(x * 127.1 + y * 311.7) * 43758.5453;
    return n - Math.floor(n);
  }

  function smoothNoise(x: number, y: number): number {
    const ix = Math.floor(x), iy = Math.floor(y);
    const fx = x - ix, fy = y - iy;
    const sx = fx * fx * (3 - 2 * fx);
    const sy = fy * fy * (3 - 2 * fy);
    const a = noise2D(ix, iy);
    const b = noise2D(ix + 1, iy);
    const c = noise2D(ix, iy + 1);
    const d = noise2D(ix + 1, iy + 1);
    return a + sx * (b - a) + sy * (c - a) + sx * sy * (d - b - c + a);
  }

  // Fractal Brownian Motion — layered noise for organic flow
  function fbm(x: number, y: number, octaves: number = 4): number {
    let val = 0, amp = 0.5, freq = 1;
    for (let i = 0; i < octaves; i++) {
      val += amp * smoothNoise(x * freq, y * freq);
      amp *= 0.5;
      freq *= 2.1;
    }
    return val;
  }

  const FLOW_COLORS = [
    { r: 37, g: 99, b: 235 },   // blue
    { r: 13, g: 148, b: 136 },  // teal
    { r: 124, g: 58, b: 237 },  // violet
    { r: 232, g: 93, b: 4 },    // warm
  ];

  interface FlowParticle {
    x: number; y: number;
    prevX: number; prevY: number;
    speed: number;
    colorIdx: number;
    life: number;
    maxLife: number;
    size: number;
  }

  let flowParticles: FlowParticle[] = [];
  let flowTime = 0;
  const mouse = { x: -9999, y: -9999, active: false };

  function resizeHero() {
    if (!heroCanvas) return;
    heroCanvas.width = heroCanvas.offsetWidth;
    heroCanvas.height = heroCanvas.offsetHeight;
    initFlowParticles();
  }

  function initFlowParticles() {
    if (!heroCanvas) return;
    flowParticles = [];
    const area = heroCanvas.width * heroCanvas.height;
    const count = Math.min(500, Math.max(100, Math.floor(area / 5000)));
    for (let i = 0; i < count; i++) {
      flowParticles.push(spawnParticle());
    }
  }

  function spawnParticle(): FlowParticle {
    const w = heroCanvas?.width || 800;
    const h = heroCanvas?.height || 600;
    const maxLife = 100 + Math.random() * 250;
    return {
      x: Math.random() * w,
      y: Math.random() * h,
      prevX: 0, prevY: 0,
      speed: 0.6 + Math.random() * 1.8,
      colorIdx: Math.floor(Math.random() * FLOW_COLORS.length),
      life: Math.random() * maxLife,
      maxLife,
      size: 0.6 + Math.random() * 1.8,
    };
  }

  function tickHero() {
    if (!heroCtx || !heroCanvas) return;
    const w = heroCanvas.width;
    const h = heroCanvas.height;

    // Slow fade creates flowing stream trails
    heroCtx.fillStyle = "rgba(6, 6, 10, 0.05)";
    heroCtx.fillRect(0, 0, w, h);

    flowTime += 0.004;
    const scale = 0.0025;

    for (const p of flowParticles) {
      p.prevX = p.x;
      p.prevY = p.y;

      // Flow angle from time-evolving noise field
      const angle = fbm(p.x * scale, p.y * scale + flowTime, 3) * Math.PI * 4;

      let vx = Math.cos(angle) * p.speed;
      let vy = Math.sin(angle) * p.speed;

      // Mouse gravity — bonus interaction, not required
      if (mouse.active) {
        const dx = mouse.x - p.x;
        const dy = mouse.y - p.y;
        const d = Math.sqrt(dx * dx + dy * dy);
        if (d < 280 && d > 0) {
          const pull = ((280 - d) / 280) * 0.5;
          vx += (dx / d) * pull;
          vy += (dy / d) * pull;
        }
      }

      p.x += vx;
      p.y += vy;
      p.life++;

      // Respawn
      if (p.life > p.maxLife || p.x < -30 || p.x > w + 30 || p.y < -30 || p.y > h + 30) {
        const np = spawnParticle();
        p.x = np.x; p.y = np.y; p.prevX = p.x; p.prevY = p.y;
        p.speed = np.speed; p.colorIdx = np.colorIdx;
        p.life = 0; p.maxLife = np.maxLife; p.size = np.size;
        continue;
      }

      // Lifecycle alpha — fade in, sustain, fade out
      const lifeRatio = p.life / p.maxLife;
      let alpha: number;
      if (lifeRatio < 0.1) alpha = lifeRatio / 0.1;
      else if (lifeRatio > 0.8) alpha = (1 - lifeRatio) / 0.2;
      else alpha = 1;
      alpha *= 0.55;

      // Draw flowing line segment
      const c = FLOW_COLORS[p.colorIdx];
      heroCtx.beginPath();
      heroCtx.moveTo(p.prevX, p.prevY);
      heroCtx.lineTo(p.x, p.y);
      heroCtx.strokeStyle = `rgba(${c.r}, ${c.g}, ${c.b}, ${alpha})`;
      heroCtx.lineWidth = p.size;
      heroCtx.lineCap = "round";
      heroCtx.stroke();
    }

    requestAnimationFrame(tickHero);
  }

  if (heroCanvas && heroCtx && !reducedMotion) {
    resizeHero();
    tickHero();
    window.addEventListener("resize", resizeHero);

    heroCanvas.parentElement?.addEventListener("mousemove", (e) => {
      const rect = heroCanvas.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
      mouse.active = true;
    });
    heroCanvas.parentElement?.addEventListener("mouseleave", () => {
      mouse.active = false; mouse.x = -9999; mouse.y = -9999;
    });
    heroCanvas.parentElement?.addEventListener("touchmove", (e) => {
      const rect = heroCanvas.getBoundingClientRect();
      const t = e.touches[0];
      mouse.x = t.clientX - rect.left;
      mouse.y = t.clientY - rect.top;
      mouse.active = true;
    }, { passive: true });
    heroCanvas.parentElement?.addEventListener("touchend", () => { mouse.active = false; });
  } else if (heroCanvas && heroCtx) {
    // Reduced motion — static scatter
    resizeHero();
    const w = heroCanvas.width, h = heroCanvas.height;
    for (let i = 0; i < 200; i++) {
      const x = Math.random() * w;
      const y = Math.random() * h;
      const c = FLOW_COLORS[Math.floor(Math.random() * FLOW_COLORS.length)];
      heroCtx.beginPath();
      heroCtx.arc(x, y, Math.random() * 2 + 0.5, 0, Math.PI * 2);
      heroCtx.fillStyle = `rgba(${c.r}, ${c.g}, ${c.b}, ${Math.random() * 0.3 + 0.1})`;
      heroCtx.fill();
    }
  }

  // ========================================
  // HERO ENTRANCE — bold, immediate
  // ========================================
  if (!reducedMotion) {
    const catchEl = document.getElementById("hero-catchphrase") as HTMLElement;
    const phrase = "Finding signal in the noise";

    catchEl.textContent = "";
    gsap.set(catchEl, { opacity: 1 });

    const heroTl = gsap.timeline({ delay: 0.3 });

    // Type the catchphrase
    let charIndex = 0;
    heroTl.to({}, {
      duration: phrase.length * 0.05,
      ease: "none",
      onUpdate: function() {
        const progress = this.progress();
        const newIndex = Math.floor(progress * phrase.length);
        if (newIndex > charIndex) {
          charIndex = newIndex;
          catchEl.textContent = phrase.slice(0, charIndex);
        }
      },
      onComplete: () => { catchEl.textContent = phrase; }
    });

    heroTl.add(() => catchEl.classList.add("typing-done"), "+=0.3");

    // Name — slam in from below, pure white, unmissable
    heroTl.to("#hero-name", {
      opacity: 1, y: 0, duration: 1.0,
      ease: "power4.out",
    }, "+=0.1");

    // Catchphrase fades subtle
    heroTl.to(catchEl, {
      color: "rgba(248, 247, 244, 0.2)",
      textShadow: "none",
      duration: 1.0,
      ease: "power2.out",
    }, "<+0.3");

    // Scroll indicator
    heroTl.to("#hero-scroll", {
      opacity: 1, duration: 1.0, ease: "power2.out"
    }, "-=0.3");

    // Parallax on scroll
    ScrollTrigger.create({
      trigger: ".hero",
      start: "top top",
      end: "bottom top",
      scrub: true,
      onUpdate: (self) => {
        const p = self.progress;
        gsap.set(".hero__content", { y: p * 150, opacity: 1 - p * 2 });
        gsap.set("#hero-scroll", { opacity: Math.max(0, 1 - p * 5) });
      },
    });

    const navBar = document.querySelector('.nav-bar');
    if (navBar) {
      ScrollTrigger.create({
        trigger: '.hero',
        start: 'bottom 80px',
        onEnter: () => navBar.classList.add('nav--visible'),
        onLeaveBack: () => navBar.classList.remove('nav--visible'),
      });
    }
  } else {
    const catchEl = document.getElementById("hero-catchphrase") as HTMLElement;
    catchEl.classList.add("typing-done");
    gsap.set("#hero-catchphrase, #hero-name, #hero-scroll", { opacity: 1 });
    gsap.set("#hero-name", { y: 0 });

    const navBar = document.querySelector('.nav-bar');
    if (navBar) {
      ScrollTrigger.create({
        trigger: '.hero',
        start: 'bottom 80px',
        onEnter: () => navBar.classList.add('nav--visible'),
        onLeaveBack: () => navBar.classList.remove('nav--visible'),
      });
    }
  }

  // ========================================
  // STATEMENT — per-word scroll color reveal
  // ========================================
  const stEl = document.getElementById("statement-1");
  if (stEl && !reducedMotion) {
    const split = SplitText.create(stEl, { type: "words" });
    split.words.forEach((w: HTMLElement) => w.classList.add("char-dim"));

    ScrollTrigger.create({
      trigger: ".statement",
      start: "top 70%",
      end: "bottom 40%",
      scrub: true,
      onUpdate: (self) => {
        const progress = self.progress;
        split.words.forEach((w: HTMLElement, i: number) => {
          const wordProgress = i / split.words.length;
          w.style.color = progress > wordProgress ? "var(--ink)" : "";
        });
      },
    });
  }

  // ========================================
  // PANEL CANVASES — Generative data streams
  //
  // Each panel has its own canvas with colored
  // data particles flowing left-to-right in
  // sine-wave patterns. Always animated autonomously.
  // Hover intensifies the flow — bold visual signal.
  // ========================================
  const panelColorMap: Record<string, { r: number; g: number; b: number }> = {
    teal:   { r: 13, g: 148, b: 136 },
    violet: { r: 124, g: 58, b: 237 },
    warm:   { r: 232, g: 93, b: 4 },
    blue:   { r: 37, g: 99, b: 235 },
  };

  interface DataStream {
    x: number; y: number;
    baseY: number;
    size: number;
    alpha: number;
    speed: number;
    phase: number;
    amp: number;
  }

  const panelAnimations: Array<{
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    color: { r: number; g: number; b: number };
    streams: DataStream[];
    time: number;
    visible: boolean;
    hovered: boolean;
  }> = [];

  document.querySelectorAll<HTMLElement>(".panel").forEach((panel) => {
    const canvas = panel.querySelector(".panel__canvas") as HTMLCanvasElement;
    const ctx = canvas?.getContext("2d");
    const colorKey = panel.dataset.color || "blue";
    const color = panelColorMap[colorKey] || panelColorMap.blue;

    if (!canvas || !ctx || reducedMotion) return;

    const anim = {
      canvas,
      ctx,
      color,
      streams: [] as DataStream[],
      time: Math.random() * 100,
      visible: false,
      hovered: false,
    };

    function resizePanel() {
      canvas.width = canvas.offsetWidth;
      canvas.height = canvas.offsetHeight;
      initStreams();
    }

    function initStreams() {
      anim.streams = [];
      const count = Math.max(12, Math.floor(canvas.width / 30));
      for (let i = 0; i < count; i++) {
        anim.streams.push({
          x: Math.random() * canvas.width,
          y: Math.random() * canvas.height,
          baseY: Math.random() * canvas.height,
          size: 1 + Math.random() * 2.5,
          alpha: 0.04 + Math.random() * 0.06,
          speed: 0.4 + Math.random() * 1.2,
          phase: Math.random() * Math.PI * 2,
          amp: 4 + Math.random() * 12,
        });
      }
    }

    resizePanel();

    panel.addEventListener("mouseenter", () => { anim.hovered = true; });
    panel.addEventListener("mouseleave", () => { anim.hovered = false; });

    const observer = new IntersectionObserver((entries) => {
      anim.visible = entries[0].isIntersecting;
    }, { threshold: 0.1 });
    observer.observe(panel);

    panelAnimations.push(anim);
    window.addEventListener("resize", resizePanel);
  });

  // Single RAF for all panel canvases
  function tickPanels() {
    for (const anim of panelAnimations) {
      if (!anim.visible) continue;
      const { ctx, canvas, color, streams } = anim;
      const w = canvas.width, h = canvas.height;
      anim.time += 0.01;

      ctx.clearRect(0, 0, w, h);

      // Hover triples intensity
      const intensityMul = anim.hovered ? 3 : 1;

      for (const s of streams) {
        s.x += s.speed;
        const waveY = s.baseY + Math.sin(s.x * 0.012 + s.phase + anim.time) * s.amp;

        if (s.x > w + 15) {
          s.x = -15;
          s.baseY = Math.random() * h;
          s.phase = Math.random() * Math.PI * 2;
        }

        const a = s.alpha * intensityMul;

        // Dot
        ctx.beginPath();
        ctx.arc(s.x, waveY, s.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${color.r}, ${color.g}, ${color.b}, ${a})`;
        ctx.fill();

        // Trailing line
        const trailLen = s.speed * 10;
        ctx.beginPath();
        ctx.moveTo(s.x, waveY);
        ctx.lineTo(s.x - trailLen, waveY);
        ctx.strokeStyle = `rgba(${color.r}, ${color.g}, ${color.b}, ${a * 0.4})`;
        ctx.lineWidth = s.size * 0.5;
        ctx.lineCap = "round";
        ctx.stroke();
      }
    }
    requestAnimationFrame(tickPanels);
  }

  if (!reducedMotion && panelAnimations.length > 0) {
    tickPanels();
  }

  // ========================================
  // PANEL REVEALS — staggered entrance
  // ========================================
  if (!reducedMotion) {
    gsap.utils.toArray<HTMLElement>(".panel").forEach((panel, i) => {
      gsap.from(panel, {
        y: 40, opacity: 0,
        duration: 0.7,
        delay: i * 0.1,
        ease: "power3.out",
        scrollTrigger: {
          trigger: panel,
          start: "top 92%",
          once: true,
        },
      });
    });
  }
</script>
