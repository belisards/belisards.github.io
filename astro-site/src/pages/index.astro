---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Adriano Belisario" description="Data journalist & researcher. Oxford, UNHCR, Bellingcat, Forensic Architecture." hideNavInitially={true}>

  <!-- ========== HERO ========== -->
  <section class="hero" id="hero">
    <canvas id="network-canvas" aria-hidden="true"></canvas>
    <div class="hero__grain" aria-hidden="true"></div>

    <!-- Vertical accent line -->
    <div class="hero__accent-line" aria-hidden="true"></div>

    <div class="hero__content">
      <p class="hero__signal-tag mono" id="hero-signal-tag">
        <span class="hero__signal-dot"></span>
        signal.acquired
      </p>

      <h1 class="hero__name" id="hero-name" aria-label="Adriano Belisario">
        <span class="hero__line hero__line--first" id="line-1">Adriano</span>
        <span class="hero__line hero__line--last" id="line-2">Belisario</span>
      </h1>

      <p class="hero__tagline" id="hero-tagline">
        Finding signal in the noise.<br />
        Data journalist &amp; researcher.
      </p>

      <div class="hero__disciplines" id="hero-disciplines">
        <span class="hero__disc-tag">Data Science</span>
        <span class="hero__disc-tag">Open Source</span>
        <span class="hero__disc-tag">Investigations</span>
      </div>
    </div>

    <div class="hero__bottom" id="hero-bottom">
      <span class="hero__location mono">Oxford &middot; Rio de Janeiro</span>
      <div class="hero__scroll-cta">
        <p class="hero__scroll-label mono" id="scroll-label">Scroll</p>
        <div class="hero__scroll-line" id="scroll-line"><span></span></div>
      </div>
    </div>
  </section>

  <!-- ========== STATEMENT ========== -->
  <section class="statement">
    <div class="statement__inner">
      <p class="statement__text" id="statement-1">
        Combining expertise in communication, open&#8209;source technologies,
        and data to address important social concerns.
      </p>
    </div>
  </section>

  <!-- ========== AFFILIATIONS ========== -->
  <section class="affiliations">
    <div class="affiliations__inner">
      <p class="affiliations__text reveal">
        Currently collaborating with the
        <a href="https://www.jointdatacenter.org/">Joint Data Center on Forced Displacement</a>
        and <a href="https://netlab.eco.ufrj.br/">Netlab/UFRJ</a>.
        MSc in Social Data Science,
        <strong>Oxford Internet Institute</strong>.
      </p>
      <div class="affiliations__logos reveal">
        <span class="affiliation-tag">Bellingcat</span>
        <span class="affiliation-tag">Forensic Architecture</span>
        <span class="affiliation-tag">UNHCR</span>
        <span class="affiliation-tag">Agência Pública</span>
        <span class="affiliation-tag">Oxford</span>
      </div>
    </div>
  </section>

  <!-- ========== NAVIGATION PANELS ========== -->
  <section class="panels">
    <a href="/code/" class="panel">
      <span class="panel__index mono">01</span>
      <div class="panel__body">
        <h2 class="panel__title">Code</h2>
        <p class="panel__desc">Data projects & code — NLP, geodata, network analysis, machine learning.</p>
      </div>
      <span class="panel__arrow">&rarr;</span>
      <div class="panel__accent panel__accent--teal"></div>
    </a>
    <a href="/publications/" class="panel">
      <span class="panel__index mono">02</span>
      <div class="panel__body">
        <h2 class="panel__title">Publications</h2>
        <p class="panel__desc">Academic papers, investigations, books & tutorials in English & Portuguese.</p>
      </div>
      <span class="panel__arrow">&rarr;</span>
      <div class="panel__accent panel__accent--violet"></div>
    </a>
    <a href="/events/" class="panel">
      <span class="panel__index mono">03</span>
      <div class="panel__body">
        <h2 class="panel__title">Events</h2>
        <p class="panel__desc">Conferences, lectures, workshops & courses across four continents.</p>
      </div>
      <span class="panel__arrow">&rarr;</span>
      <div class="panel__accent panel__accent--warm"></div>
    </a>
    <a href="/about/" class="panel">
      <span class="panel__index mono">04</span>
      <div class="panel__body">
        <h2 class="panel__title">About</h2>
        <p class="panel__desc">CV, education, professional experience & collaborations.</p>
      </div>
      <span class="panel__arrow">&rarr;</span>
      <div class="panel__accent panel__accent--blue"></div>
    </a>
  </section>

</BaseLayout>

<style>
  /* ============================
     HERO — Signal Acquired
     ============================ */
  .hero {
    position: relative;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    overflow: hidden;
    margin-left: calc(-50vw + 50%);
    background: #0a0a0c;
  }

  #network-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  /* Film grain overlay */
  .hero__grain {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    background-repeat: repeat;
    z-index: 1;
    pointer-events: none;
    opacity: 0.5;
    mix-blend-mode: overlay;
  }

  /* Vertical accent line */
  .hero__accent-line {
    position: absolute;
    left: 2rem;
    top: 15%;
    bottom: 15%;
    width: 2px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--signal-primary) 30%,
      var(--signal-teal) 70%,
      transparent
    );
    z-index: 2;
    opacity: 0;
  }

  /* Content container */
  .hero__content {
    position: relative;
    z-index: 2;
    padding: 0 4rem 8rem 5rem;
    max-width: 1200px;
  }

  /* Signal tag */
  .hero__signal-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    color: var(--signal-teal);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
    opacity: 0;
  }

  .hero__signal-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal-teal);
    animation: dotPulse 2s ease-in-out infinite;
  }

  @keyframes dotPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(13, 148, 136, 0.6); }
    50% { box-shadow: 0 0 0 6px rgba(13, 148, 136, 0); }
  }

  /* Name — massive, left-aligned */
  .hero__name {
    font-size: clamp(5rem, 16vw, 14rem);
    font-weight: 700;
    letter-spacing: -0.07em;
    line-height: 0.82;
    margin: 0 0 2rem;
    background: linear-gradient(
      135deg,
      #ffffff 0%,
      #f8f7f4 25%,
      var(--signal-primary) 70%,
      var(--signal-teal) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero__line {
    display: block;
    opacity: 0;
    will-change: transform, opacity;
  }

  .hero__line--last {
    padding-left: clamp(1rem, 4vw, 5rem);
  }

  /* Tagline */
  .hero__tagline {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.5vw, 1.6rem);
    font-weight: 400;
    line-height: 1.6;
    color: rgba(248, 247, 244, 0.55);
    max-width: 500px;
    margin-bottom: 2rem;
    opacity: 0;
    letter-spacing: -0.01em;
  }

  /* Discipline tags */
  .hero__disciplines {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    opacity: 0;
  }

  .hero__disc-tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(248, 247, 244, 0.35);
    border: 1px solid rgba(248, 247, 244, 0.1);
    padding: 0.35rem 0.8rem;
    border-radius: 100px;
    transition: border-color 0.4s ease, color 0.4s ease;
  }

  .hero__disc-tag:hover {
    border-color: var(--signal-primary);
    color: rgba(248, 247, 244, 0.6);
  }

  /* Hero bottom — split layout */
  .hero__bottom {
    position: absolute;
    bottom: 2.5rem;
    left: 5rem;
    right: 4rem;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    opacity: 0;
  }

  .hero__location {
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(248, 247, 244, 0.2);
  }

  .hero__scroll-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .hero__scroll-label {
    font-size: 0.6rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(248, 247, 244, 0.3);
  }

  .hero__scroll-line span {
    display: block;
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, rgba(37, 99, 235, 0.6), transparent);
    animation: linePulse 2.5s ease-in-out infinite;
  }

  @keyframes linePulse {
    0%, 100% { transform: scaleY(0.4); opacity: 0.3; transform-origin: top; }
    50% { transform: scaleY(1); opacity: 1; transform-origin: top; }
  }

  /* ============================
     STATEMENT — big text scroll reveal
     ============================ */
  .statement {
    padding: 10rem 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
  }

  .statement__inner {
    max-width: 900px;
  }

  .statement__text {
    font-size: clamp(1.5rem, 4vw, 3rem);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  /* Chars start invisible, GSAP reveals them */
  :global(.statement__text .char-dim) {
    color: var(--ink-tertiary);
    transition: color 0.3s ease;
  }

  /* ============================
     AFFILIATIONS
     ============================ */
  .affiliations {
    padding: 0 2rem 8rem;
  }

  .affiliations__inner {
    max-width: 700px;
    margin: 0 auto;
  }

  .affiliations__text {
    font-size: 1.1rem;
    line-height: 2;
    color: var(--ink-secondary);
    margin-bottom: 2rem;
  }

  .affiliations__logos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .affiliation-tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-tertiary);
    border: 1px solid var(--border);
    padding: 0.4rem 0.9rem;
    border-radius: 100px;
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .affiliation-tag:hover {
    color: var(--signal-primary);
    border-color: var(--signal-primary);
  }

  /* ============================
     PANELS — horizontal list
     ============================ */
  .panels {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    border-top: 1px solid var(--border);
  }

  .panel {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 2.5rem 3rem;
    text-decoration: none;
    color: var(--ink);
    border-bottom: 1px solid var(--border);
    position: relative;
    overflow: hidden;
    transition: background 0.4s ease;
  }

  .panel:hover {
    background: rgba(37, 99, 235, 0.03);
  }

  .panel__index {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    color: var(--ink-tertiary);
    flex-shrink: 0;
    width: 2rem;
  }

  .panel__body {
    flex: 1;
  }

  .panel__title {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 0.25rem;
    line-height: 1.1;
    color: var(--ink);
    transition: color 0.3s ease;
  }

  .panel:hover .panel__title {
    color: var(--signal-primary);
  }

  .panel__desc {
    font-size: 0.85rem;
    color: var(--ink-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .panel__arrow {
    font-size: 1.5rem;
    color: var(--ink-tertiary);
    flex-shrink: 0;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .panel:hover .panel__arrow {
    transform: translateX(6px);
    color: var(--signal-primary);
  }

  /* Accent bar on left */
  .panel__accent {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    transform: scaleY(0);
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .panel:hover .panel__accent {
    transform: scaleY(1);
  }

  .panel__accent--teal { background: var(--signal-teal); }
  .panel__accent--violet { background: var(--signal-violet); }
  .panel__accent--warm { background: var(--signal-warm); }
  .panel__accent--blue { background: var(--signal-primary); }

  /* Custom hover tints per panel */
  .panel:has(.panel__accent--teal):hover { background: rgba(13, 148, 136, 0.04); }
  .panel:has(.panel__accent--teal):hover .panel__title { color: var(--signal-teal); }
  .panel:has(.panel__accent--teal):hover .panel__arrow { color: var(--signal-teal); }

  .panel:has(.panel__accent--violet):hover { background: rgba(124, 58, 237, 0.04); }
  .panel:has(.panel__accent--violet):hover .panel__title { color: var(--signal-violet); }
  .panel:has(.panel__accent--violet):hover .panel__arrow { color: var(--signal-violet); }

  .panel:has(.panel__accent--warm):hover { background: rgba(232, 93, 4, 0.04); }
  .panel:has(.panel__accent--warm):hover .panel__title { color: var(--signal-warm); }
  .panel:has(.panel__accent--warm):hover .panel__arrow { color: var(--signal-warm); }

  .panel:has(.panel__accent--blue):hover { background: rgba(37, 99, 235, 0.04); }

  /* ============================
     RESPONSIVE
     ============================ */
  @media screen and (max-width: 768px) {
    .hero__content {
      padding: 0 1.5rem 7rem 1.5rem;
    }

    .hero__accent-line {
      left: 1rem;
      top: 20%;
      bottom: 20%;
    }

    .hero__name {
      font-size: clamp(3.5rem, 18vw, 7rem);
    }

    .hero__line--last {
      padding-left: clamp(0.5rem, 3vw, 2rem);
    }

    .hero__tagline {
      font-size: clamp(1rem, 4vw, 1.3rem);
    }

    .hero__bottom {
      left: 1.5rem;
      right: 1.5rem;
    }

    .hero__location {
      display: none;
    }

    .statement {
      padding: 6rem 1.5rem;
      min-height: auto;
    }

    .statement__text {
      font-size: clamp(1.3rem, 5vw, 2rem);
    }

    .affiliations {
      padding: 0 1.5rem 5rem;
    }

    .panel {
      padding: 2rem 1.5rem;
      gap: 1rem;
    }

    .panel__title {
      font-size: 1.4rem;
    }

    .panel__desc {
      display: none;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";
  import { CustomEase } from "gsap/CustomEase";

  gsap.registerPlugin(ScrollTrigger, SplitText, CustomEase);

  CustomEase.create("smooth", "M0,0 C0.22,0.61 0.36,1 0.59,1 0.68,1 0.82,0.98 1,1");

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ========================================
  // PARTICLE NETWORK — refined, premium feel
  // ========================================
  const canvas = document.getElementById("network-canvas") as HTMLCanvasElement;
  const ctx = canvas?.getContext("2d");

  interface Node {
    x: number; y: number;
    baseX: number; baseY: number;
    vx: number; vy: number;
    r: number; alpha: number;
  }

  const mouse = { x: -9999, y: -9999, active: false };
  let nodes: Node[] = [];
  const LINK_DIST = 160;
  const MOUSE_R = 220;

  function resize() {
    if (!canvas) return;
    canvas.width = canvas.offsetWidth;
    canvas.height = canvas.offsetHeight;
    createNodes();
  }

  function createNodes() {
    if (!canvas) return;
    nodes = [];
    const density = Math.min(140, Math.max(50, Math.floor(canvas.width * canvas.height / 10000)));
    for (let i = 0; i < density; i++) {
      const x = Math.random() * canvas.width;
      const y = Math.random() * canvas.height;
      nodes.push({
        x, y, baseX: x, baseY: y,
        vx: (Math.random() - 0.5) * 0.3,
        vy: (Math.random() - 0.5) * 0.3,
        r: Math.random() * 1.8 + 0.5,
        alpha: Math.random() * 0.4 + 0.1,
      });
    }
  }

  function tick() {
    if (!ctx || !canvas) return;
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    for (let i = 0; i < nodes.length; i++) {
      const a = nodes[i];

      // Mouse repulsion
      if (mouse.active) {
        const dx = a.x - mouse.x;
        const dy = a.y - mouse.y;
        const d = Math.sqrt(dx * dx + dy * dy);
        if (d < MOUSE_R && d > 0) {
          const f = ((MOUSE_R - d) / MOUSE_R) * 0.6;
          a.vx += (dx / d) * f;
          a.vy += (dy / d) * f;
        }
      }

      // Return to base
      a.vx += (a.baseX - a.x) * 0.0004;
      a.vy += (a.baseY - a.y) * 0.0004;
      a.vx *= 0.97;
      a.vy *= 0.97;
      a.x += a.vx;
      a.y += a.vy;

      // Edges
      if (a.x < 0) { a.x = 0; a.vx *= -0.5; }
      if (a.x > canvas.width) { a.x = canvas.width; a.vx *= -0.5; }
      if (a.y < 0) { a.y = 0; a.vy *= -0.5; }
      if (a.y > canvas.height) { a.y = canvas.height; a.vy *= -0.5; }

      // Node-to-node lines
      for (let j = i + 1; j < nodes.length; j++) {
        const b = nodes[j];
        const d = Math.hypot(a.x - b.x, a.y - b.y);
        if (d < LINK_DIST) {
          const opacity = (1 - d / LINK_DIST) * 0.1;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.strokeStyle = `rgba(37, 99, 235, ${opacity})`;
          ctx.lineWidth = 0.5;
          ctx.stroke();
        }
      }

      // Mouse attraction lines
      if (mouse.active) {
        const md = Math.hypot(a.x - mouse.x, a.y - mouse.y);
        if (md < MOUSE_R) {
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(mouse.x, mouse.y);
          ctx.strokeStyle = `rgba(248, 247, 244, ${(1 - md / MOUSE_R) * 0.2})`;
          ctx.lineWidth = 0.3;
          ctx.stroke();
        }
      }

      // Draw dot — proximity glow near name position
      const centerX = canvas.width * 0.35;
      const centerY = canvas.height * 0.65;
      const distToCenter = Math.hypot(a.x - centerX, a.y - centerY);
      const maxDist = Math.hypot(canvas.width, canvas.height) * 0.4;
      const proximity = Math.max(0, 1 - distToCenter / maxDist);
      const boostedAlpha = a.alpha + proximity * 0.15;
      const boostedR = a.r + proximity * 0.5;

      ctx.beginPath();
      ctx.arc(a.x, a.y, boostedR, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(37, 99, 235, ${boostedAlpha})`;
      ctx.fill();
    }

    requestAnimationFrame(tick);
  }

  if (canvas && ctx && !reducedMotion) {
    resize();
    tick();
    window.addEventListener("resize", resize);

    canvas.parentElement?.addEventListener("mousemove", (e) => {
      const rect = canvas.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
      mouse.active = true;
    });
    canvas.parentElement?.addEventListener("mouseleave", () => {
      mouse.active = false; mouse.x = -9999; mouse.y = -9999;
    });
    canvas.parentElement?.addEventListener("touchmove", (e) => {
      const rect = canvas.getBoundingClientRect();
      const t = e.touches[0];
      mouse.x = t.clientX - rect.left;
      mouse.y = t.clientY - rect.top;
      mouse.active = true;
    }, { passive: true });
    canvas.parentElement?.addEventListener("touchend", () => { mouse.active = false; });
  } else if (canvas && ctx) {
    // Static snapshot for reduced motion
    resize();
    for (let i = 0; i < nodes.length; i++) {
      const a = nodes[i];
      ctx.beginPath();
      ctx.arc(a.x, a.y, a.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(37, 99, 235, ${a.alpha * 0.5})`;
      ctx.fill();
    }
  }

  // ========================================
  // HERO ANIMATIONS — Cinematic "Signal Acquired"
  // ========================================
  if (!reducedMotion) {
    const heroTl = gsap.timeline({ delay: 0.3 });

    // Phase 1: Accent line draws in
    heroTl.fromTo(".hero__accent-line",
      { opacity: 0, scaleY: 0 },
      { opacity: 0.6, scaleY: 1, duration: 1.2, ease: "power3.inOut",
        transformOrigin: "top center" }
    );

    // Phase 2: Signal tag
    heroTl.to("#hero-signal-tag", {
      opacity: 1, duration: 0.8, ease: "power2.out"
    }, "-=0.6");

    // Phase 3: Name — SplitText per-character, cinematic stagger
    const l1 = SplitText.create("#line-1", { type: "chars" });
    const l2 = SplitText.create("#line-2", { type: "chars" });

    heroTl.to("#line-1", { opacity: 1, duration: 0.01 }, "-=0.3");
    heroTl.from(l1.chars, {
      y: 80, rotationX: -90, opacity: 0,
      duration: 1.0, ease: "smooth", stagger: 0.04,
      transformOrigin: "bottom center",
    }, "<");

    heroTl.to("#line-2", { opacity: 1, duration: 0.01 }, "-=0.5");
    heroTl.from(l2.chars, {
      y: 80, rotationX: -90, opacity: 0,
      duration: 1.0, ease: "smooth", stagger: 0.04,
      transformOrigin: "bottom center",
    }, "<");

    // Phase 4: Tagline fades up
    heroTl.fromTo("#hero-tagline",
      { y: 30, opacity: 0 },
      { y: 0, opacity: 1, duration: 1.0, ease: "power2.out" },
      "-=0.4"
    );

    // Phase 5: Discipline tags stagger in
    heroTl.fromTo(".hero__disc-tag",
      { y: 15, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.6, ease: "power2.out", stagger: 0.1 },
      "-=0.5"
    );

    // Phase 6: Bottom bar
    heroTl.to("#hero-bottom", {
      opacity: 1, duration: 1, ease: "power2.out"
    }, "-=0.3");

    // Parallax on scroll
    ScrollTrigger.create({
      trigger: ".hero",
      start: "top top",
      end: "bottom top",
      scrub: true,
      onUpdate: (self) => {
        const p = self.progress;
        gsap.set(".hero__content", { y: p * 200, opacity: 1 - p * 2.5 });
        gsap.set("#hero-bottom", { opacity: Math.max(0, 1 - p * 5) });
        gsap.set(".hero__accent-line", { opacity: 0.6 * (1 - p * 2) });
      },
    });

    // Nav reveal after hero
    const navBar = document.querySelector('.nav-bar');
    if (navBar) {
      ScrollTrigger.create({
        trigger: '.hero',
        start: 'bottom 80px',
        onEnter: () => navBar.classList.add('nav--visible'),
        onLeaveBack: () => navBar.classList.remove('nav--visible'),
      });
    }
  } else {
    gsap.set("#line-1, #line-2, #hero-signal-tag, #hero-tagline, .hero__disciplines, #hero-bottom", { opacity: 1 });
    gsap.set(".hero__accent-line", { opacity: 0.6 });

    // Still reveal nav on scroll for reduced motion
    const navBar = document.querySelector('.nav-bar');
    if (navBar) {
      ScrollTrigger.create({
        trigger: '.hero',
        start: 'bottom 80px',
        onEnter: () => navBar.classList.add('nav--visible'),
        onLeaveBack: () => navBar.classList.remove('nav--visible'),
      });
    }
  }

  // ========================================
  // STATEMENT — per-word scroll color reveal
  // ========================================
  const stEl = document.getElementById("statement-1");
  if (stEl && !reducedMotion) {
    const split = SplitText.create(stEl, { type: "words" });

    // Start all words dim
    split.words.forEach((w: HTMLElement) => w.classList.add("char-dim"));

    ScrollTrigger.create({
      trigger: ".statement",
      start: "top 70%",
      end: "bottom 40%",
      scrub: true,
      onUpdate: (self) => {
        const progress = self.progress;
        split.words.forEach((w: HTMLElement, i: number) => {
          const wordProgress = i / split.words.length;
          if (progress > wordProgress) {
            w.style.color = "var(--ink)";
          } else {
            w.style.color = "";
          }
        });
      },
    });
  }

  // ========================================
  // PANEL REVEALS
  // ========================================
  if (!reducedMotion) {
    gsap.utils.toArray<HTMLElement>(".panel").forEach((panel, i) => {
      gsap.from(panel, {
        y: 30, opacity: 0,
        duration: 0.6,
        delay: i * 0.08,
        ease: "power2.out",
        scrollTrigger: {
          trigger: panel,
          start: "top 90%",
          once: true,
        },
      });
    });
  }
</script>
