---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Adriano Belisario" description="Data journalist & researcher. Oxford, UNHCR, Bellingcat, Forensic Architecture." hideNavInitially={true}>

  <!-- ========== HERO ========== -->
  <section class="hero" id="hero">
    <canvas id="network-canvas" aria-hidden="true"></canvas>
    <div class="hero__grain" aria-hidden="true"></div>

    <div class="hero__content">
      <!-- Catchy sentence — appears first, centered -->
      <p class="hero__catchphrase mono" id="hero-catchphrase">Finding signal in the noise</p>

      <!-- Waveform SVG — noisy → clean morph -->
      <svg class="hero__waveform" id="hero-waveform" viewBox="0 0 800 120" preserveAspectRatio="none" aria-hidden="true">
        <!-- Noisy waveform — visible, will morph -->
        <path id="wave-noise" d="M0,60 C20,25 40,95 60,40 C80,85 100,15 120,70 C140,30 160,90 180,45 C200,80 220,20 240,65 C260,35 280,85 300,50 C320,75 340,25 360,55 C380,85 400,15 420,60 C440,95 460,30 480,70 C500,20 520,80 540,45 C560,90 580,35 600,55 C620,75 640,25 660,65 C680,40 700,80 720,50 C740,30 760,70 780,45 L800,60"
          fill="none" stroke="url(#waveGradient)" stroke-width="2" stroke-linecap="round" />
        <!-- Clean signal line — morph target (hidden) -->
        <path id="wave-signal" d="M0,60 L800,60" fill="none" stroke="none" />
        <defs>
          <linearGradient id="waveGradient" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="rgba(13, 148, 136, 0.6)" />
            <stop offset="50%" stop-color="rgba(37, 99, 235, 0.8)" />
            <stop offset="100%" stop-color="rgba(13, 148, 136, 0.6)" />
          </linearGradient>
        </defs>
      </svg>

      <!-- Name — massive reveal after catchphrase -->
      <h1 class="hero__name" id="hero-name" aria-label="Adriano Belisario">
        <span class="hero__line" id="line-1">Adriano</span>
        <span class="hero__line" id="line-2">Belisario</span>
      </h1>
    </div>

    <!-- Scroll indicator — minimal -->
    <div class="hero__scroll" id="hero-scroll">
      <div class="hero__scroll-line"><span></span></div>
    </div>
  </section>

  <!-- ========== LOGO STRIP ========== -->
  <section class="logo-strip">
    <p class="logo-strip__label mono">Collaborated with</p>
    <div class="logo-strip__inner">
      <img src="/images/logos/oxford.svg" alt="Oxford" class="logo-strip__img" />
      <img src="/images/logos/unhcr.svg" alt="UNHCR" class="logo-strip__img" />
      <img src="/images/logos/bellingcat.svg" alt="Bellingcat" class="logo-strip__img" />
      <img src="/images/logos/forensic-architecture.svg" alt="Forensic Architecture" class="logo-strip__img" />
      <img src="/images/logos/agencia-publica.svg" alt="Agência Pública" class="logo-strip__img" />
    </div>
  </section>

  <!-- ========== STATEMENT ========== -->
  <section class="statement">
    <div class="statement__inner">
      <p class="statement__text" id="statement-1">
        Combining expertise in communication, open&#8209;source technologies,
        and data to address important social concerns.
      </p>
    </div>
  </section>

  <!-- ========== AFFILIATIONS ========== -->
  <section class="affiliations">
    <div class="affiliations__inner">
      <p class="affiliations__text reveal">
        Currently collaborating with the
        <a href="https://www.jointdatacenter.org/">Joint Data Center on Forced Displacement</a>
        and <a href="https://netlab.eco.ufrj.br/">Netlab/UFRJ</a>.
        MSc in Social Data Science,
        <strong>Oxford Internet Institute</strong>.
      </p>
      <div class="affiliations__logos reveal">
        <span class="affiliation-tag">Bellingcat</span>
        <span class="affiliation-tag">Forensic Architecture</span>
        <span class="affiliation-tag">UNHCR</span>
        <span class="affiliation-tag">Agência Pública</span>
        <span class="affiliation-tag">Oxford</span>
      </div>
    </div>
  </section>

  <!-- ========== NAVIGATION PANELS ========== -->
  <section class="panels">
    <a href="/code/" class="panel">
      <span class="panel__index mono">01</span>
      <div class="panel__body">
        <h2 class="panel__title">Code</h2>
        <p class="panel__desc">Data projects & code — NLP, geodata, network analysis, machine learning.</p>
      </div>
      <span class="panel__arrow">&rarr;</span>
      <div class="panel__accent panel__accent--teal"></div>
    </a>
    <a href="/publications/" class="panel">
      <span class="panel__index mono">02</span>
      <div class="panel__body">
        <h2 class="panel__title">Publications</h2>
        <p class="panel__desc">Academic papers, investigations, books & tutorials in English & Portuguese.</p>
      </div>
      <span class="panel__arrow">&rarr;</span>
      <div class="panel__accent panel__accent--violet"></div>
    </a>
    <a href="/events/" class="panel">
      <span class="panel__index mono">03</span>
      <div class="panel__body">
        <h2 class="panel__title">Events</h2>
        <p class="panel__desc">Conferences, lectures, workshops & courses across four continents.</p>
      </div>
      <span class="panel__arrow">&rarr;</span>
      <div class="panel__accent panel__accent--warm"></div>
    </a>
    <a href="/about/" class="panel">
      <span class="panel__index mono">04</span>
      <div class="panel__body">
        <h2 class="panel__title">About</h2>
        <p class="panel__desc">CV, education, professional experience & collaborations.</p>
      </div>
      <span class="panel__arrow">&rarr;</span>
      <div class="panel__accent panel__accent--blue"></div>
    </a>
  </section>

</BaseLayout>

<style>
  /* ============================
     HERO — Cinematic Impact
     ============================ */
  .hero {
    position: relative;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-left: calc(-50vw + 50%);
    background: #0a0a0c;
  }

  #network-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero__grain {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    background-repeat: repeat;
    z-index: 1;
    pointer-events: none;
    opacity: 0.5;
    mix-blend-mode: overlay;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 2rem;
  }

  /* Catchphrase — appears first, monospace, glowing */
  .hero__catchphrase {
    font-size: clamp(0.85rem, 2vw, 1.2rem);
    letter-spacing: 0.12em;
    color: var(--signal-teal);
    margin-bottom: 3rem;
    opacity: 0;
    text-shadow: 0 0 30px rgba(13, 148, 136, 0.3);
  }

  /* Blinking cursor for typing effect */
  .hero__catchphrase::after {
    content: '|';
    animation: cursorBlink 0.8s step-end infinite;
    color: var(--signal-teal);
    margin-left: 2px;
    font-weight: 300;
  }

  .hero__catchphrase.typing-done::after {
    display: none;
  }

  @keyframes cursorBlink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* Waveform SVG — spans full width between catchphrase and name */
  .hero__waveform {
    width: min(90vw, 800px);
    height: 80px;
    margin-bottom: 2rem;
    opacity: 0;
    overflow: visible;
  }

  /* Name — viewport-filling, centered, gradient */
  .hero__name {
    font-size: clamp(5rem, 18vw, 16rem);
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 0.85;
    margin: 0;
    background: linear-gradient(
      160deg,
      #ffffff 0%,
      #e8e8e8 30%,
      var(--signal-primary) 65%,
      var(--signal-teal) 100%
    );
    background-size: 200% 200%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    opacity: 0;
    transform: scale(0.9);
  }

  .hero__line {
    display: block;
    will-change: transform, opacity;
  }

  /* Scroll indicator — dead center bottom */
  .hero__scroll {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    opacity: 0;
  }

  .hero__scroll-line span {
    display: block;
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, rgba(13, 148, 136, 0.5), transparent);
    animation: linePulse 2.5s ease-in-out infinite;
  }

  @keyframes linePulse {
    0%, 100% { transform: scaleY(0.3); opacity: 0.2; transform-origin: top; }
    50% { transform: scaleY(1); opacity: 0.8; transform-origin: top; }
  }

  /* ============================
     LOGO STRIP — full-width below hero
     ============================ */
  .logo-strip {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    background: #0a0a0c;
    padding: 3.5rem 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    text-align: center;
  }

  .logo-strip__label {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(248, 247, 244, 0.35);
    margin: 0 0 2rem;
  }

  .logo-strip__inner {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3.5rem;
    flex-wrap: wrap;
  }

  .logo-strip__img {
    height: 22px;
    opacity: 0.35;
    filter: grayscale(1) brightness(2);
    transition: opacity 0.4s ease, filter 0.4s ease;
  }

  .logo-strip__img:hover {
    opacity: 0.7;
    filter: grayscale(0) brightness(1);
  }

  /* ============================
     STATEMENT — big text scroll reveal
     ============================ */
  .statement {
    padding: 10rem 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
  }

  .statement__inner {
    max-width: 900px;
  }

  .statement__text {
    font-size: clamp(1.5rem, 4vw, 3rem);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  /* Chars start invisible, GSAP reveals them */
  :global(.statement__text .char-dim) {
    color: var(--ink-tertiary);
    transition: color 0.3s ease;
  }

  /* ============================
     AFFILIATIONS
     ============================ */
  .affiliations {
    padding: 0 2rem 8rem;
  }

  .affiliations__inner {
    max-width: 700px;
    margin: 0 auto;
  }

  .affiliations__text {
    font-size: 1.1rem;
    line-height: 2;
    color: var(--ink-secondary);
    margin-bottom: 2rem;
  }

  .affiliations__logos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .affiliation-tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-tertiary);
    border: 1px solid var(--border);
    padding: 0.4rem 0.9rem;
    border-radius: 100px;
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .affiliation-tag:hover {
    color: var(--signal-primary);
    border-color: var(--signal-primary);
  }

  /* ============================
     PANELS — horizontal list
     ============================ */
  .panels {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    border-top: 1px solid var(--border);
  }

  .panel {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 2.5rem 3rem;
    text-decoration: none;
    color: var(--ink);
    border-bottom: 1px solid var(--border);
    position: relative;
    overflow: hidden;
    transition: background 0.4s ease;
  }

  .panel:hover {
    background: rgba(37, 99, 235, 0.03);
  }

  .panel__index {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    color: var(--ink-tertiary);
    flex-shrink: 0;
    width: 2rem;
  }

  .panel__body {
    flex: 1;
  }

  .panel__title {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 0.25rem;
    line-height: 1.1;
    color: var(--ink);
    transition: color 0.3s ease;
  }

  .panel:hover .panel__title {
    color: var(--signal-primary);
  }

  .panel__desc {
    font-size: 0.85rem;
    color: var(--ink-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .panel__arrow {
    font-size: 1.5rem;
    color: var(--ink-tertiary);
    flex-shrink: 0;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .panel:hover .panel__arrow {
    transform: translateX(6px);
    color: var(--signal-primary);
  }

  /* Accent bar on left */
  .panel__accent {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    transform: scaleY(0);
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .panel:hover .panel__accent {
    transform: scaleY(1);
  }

  .panel__accent--teal { background: var(--signal-teal); }
  .panel__accent--violet { background: var(--signal-violet); }
  .panel__accent--warm { background: var(--signal-warm); }
  .panel__accent--blue { background: var(--signal-primary); }

  /* Custom hover tints per panel */
  .panel:has(.panel__accent--teal):hover { background: rgba(13, 148, 136, 0.04); }
  .panel:has(.panel__accent--teal):hover .panel__title { color: var(--signal-teal); }
  .panel:has(.panel__accent--teal):hover .panel__arrow { color: var(--signal-teal); }

  .panel:has(.panel__accent--violet):hover { background: rgba(124, 58, 237, 0.04); }
  .panel:has(.panel__accent--violet):hover .panel__title { color: var(--signal-violet); }
  .panel:has(.panel__accent--violet):hover .panel__arrow { color: var(--signal-violet); }

  .panel:has(.panel__accent--warm):hover { background: rgba(232, 93, 4, 0.04); }
  .panel:has(.panel__accent--warm):hover .panel__title { color: var(--signal-warm); }
  .panel:has(.panel__accent--warm):hover .panel__arrow { color: var(--signal-warm); }

  .panel:has(.panel__accent--blue):hover { background: rgba(37, 99, 235, 0.04); }

  /* ============================
     RESPONSIVE
     ============================ */
  @media screen and (max-width: 768px) {
    .hero__name {
      font-size: clamp(3.5rem, 20vw, 7rem);
    }

    .hero__catchphrase {
      font-size: clamp(0.75rem, 3.5vw, 1rem);
      margin-bottom: 1.5rem;
    }

    .hero__waveform {
      height: 50px;
      margin-bottom: 1.5rem;
    }

    .logo-strip {
      padding: 2.5rem 1.5rem;
    }

    .logo-strip__label {
      margin-bottom: 1.5rem;
    }

    .logo-strip__inner {
      gap: 2rem;
    }

    .logo-strip__img {
      height: 18px;
    }

    .statement {
      padding: 6rem 1.5rem;
      min-height: auto;
    }

    .statement__text {
      font-size: clamp(1.3rem, 5vw, 2rem);
    }

    .affiliations {
      padding: 0 1.5rem 5rem;
    }

    .panel {
      padding: 2rem 1.5rem;
      gap: 1rem;
    }

    .panel__title {
      font-size: 1.4rem;
    }

    .panel__desc {
      display: none;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";
  import { CustomEase } from "gsap/CustomEase";
  import { MorphSVGPlugin } from "gsap/MorphSVGPlugin";
  import { Physics2DPlugin } from "gsap/Physics2DPlugin";

  gsap.registerPlugin(ScrollTrigger, SplitText, CustomEase, MorphSVGPlugin, Physics2DPlugin);

  CustomEase.create("smooth", "M0,0 C0.22,0.61 0.36,1 0.59,1 0.68,1 0.82,0.98 1,1");

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ========================================
  // PARTICLE NETWORK — refined, premium feel
  // ========================================
  const canvas = document.getElementById("network-canvas") as HTMLCanvasElement;
  const ctx = canvas?.getContext("2d");

  interface Node {
    x: number; y: number;
    baseX: number; baseY: number;
    vx: number; vy: number;
    r: number; alpha: number;
  }

  const mouse = { x: -9999, y: -9999, active: false };
  let nodes: Node[] = [];
  const LINK_DIST = 160;
  const MOUSE_R = 220;

  function resize() {
    if (!canvas) return;
    canvas.width = canvas.offsetWidth;
    canvas.height = canvas.offsetHeight;
    createNodes();
  }

  function createNodes() {
    if (!canvas) return;
    nodes = [];
    const density = Math.min(140, Math.max(50, Math.floor(canvas.width * canvas.height / 10000)));
    for (let i = 0; i < density; i++) {
      const x = Math.random() * canvas.width;
      const y = Math.random() * canvas.height;
      nodes.push({
        x, y, baseX: x, baseY: y,
        vx: (Math.random() - 0.5) * 0.3,
        vy: (Math.random() - 0.5) * 0.3,
        r: Math.random() * 1.8 + 0.5,
        alpha: Math.random() * 0.4 + 0.1,
      });
    }
  }

  function tick() {
    if (!ctx || !canvas) return;
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    for (let i = 0; i < nodes.length; i++) {
      const a = nodes[i];

      // Mouse repulsion
      if (mouse.active) {
        const dx = a.x - mouse.x;
        const dy = a.y - mouse.y;
        const d = Math.sqrt(dx * dx + dy * dy);
        if (d < MOUSE_R && d > 0) {
          const f = ((MOUSE_R - d) / MOUSE_R) * 0.6;
          a.vx += (dx / d) * f;
          a.vy += (dy / d) * f;
        }
      }

      // Return to base
      a.vx += (a.baseX - a.x) * 0.0004;
      a.vy += (a.baseY - a.y) * 0.0004;
      a.vx *= 0.97;
      a.vy *= 0.97;
      a.x += a.vx;
      a.y += a.vy;

      // Edges
      if (a.x < 0) { a.x = 0; a.vx *= -0.5; }
      if (a.x > canvas.width) { a.x = canvas.width; a.vx *= -0.5; }
      if (a.y < 0) { a.y = 0; a.vy *= -0.5; }
      if (a.y > canvas.height) { a.y = canvas.height; a.vy *= -0.5; }

      // Node-to-node lines
      for (let j = i + 1; j < nodes.length; j++) {
        const b = nodes[j];
        const d = Math.hypot(a.x - b.x, a.y - b.y);
        if (d < LINK_DIST) {
          const opacity = (1 - d / LINK_DIST) * 0.1;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.strokeStyle = `rgba(37, 99, 235, ${opacity})`;
          ctx.lineWidth = 0.5;
          ctx.stroke();
        }
      }

      // Mouse attraction lines
      if (mouse.active) {
        const md = Math.hypot(a.x - mouse.x, a.y - mouse.y);
        if (md < MOUSE_R) {
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(mouse.x, mouse.y);
          ctx.strokeStyle = `rgba(248, 247, 244, ${(1 - md / MOUSE_R) * 0.2})`;
          ctx.lineWidth = 0.3;
          ctx.stroke();
        }
      }

      // Draw dot — proximity glow near center
      const centerX = canvas.width * 0.5;
      const centerY = canvas.height * 0.5;
      const distToCenter = Math.hypot(a.x - centerX, a.y - centerY);
      const maxDist = Math.hypot(canvas.width, canvas.height) * 0.4;
      const proximity = Math.max(0, 1 - distToCenter / maxDist);
      const boostedAlpha = a.alpha + proximity * 0.15;
      const boostedR = a.r + proximity * 0.5;

      ctx.beginPath();
      ctx.arc(a.x, a.y, boostedR, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(37, 99, 235, ${boostedAlpha})`;
      ctx.fill();
    }

    requestAnimationFrame(tick);
  }

  if (canvas && ctx && !reducedMotion) {
    resize();
    tick();
    window.addEventListener("resize", resize);

    canvas.parentElement?.addEventListener("mousemove", (e) => {
      const rect = canvas.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
      mouse.active = true;
    });
    canvas.parentElement?.addEventListener("mouseleave", () => {
      mouse.active = false; mouse.x = -9999; mouse.y = -9999;
    });
    canvas.parentElement?.addEventListener("touchmove", (e) => {
      const rect = canvas.getBoundingClientRect();
      const t = e.touches[0];
      mouse.x = t.clientX - rect.left;
      mouse.y = t.clientY - rect.top;
      mouse.active = true;
    }, { passive: true });
    canvas.parentElement?.addEventListener("touchend", () => { mouse.active = false; });
  } else if (canvas && ctx) {
    // Static snapshot for reduced motion
    resize();
    for (let i = 0; i < nodes.length; i++) {
      const a = nodes[i];
      ctx.beginPath();
      ctx.arc(a.x, a.y, a.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(37, 99, 235, ${a.alpha * 0.5})`;
      ctx.fill();
    }
  }

  // ========================================
  // HERO ANIMATIONS — Signal in the Noise
  // ========================================
  if (!reducedMotion) {
    const catchEl = document.getElementById("hero-catchphrase") as HTMLElement;
    const waveformSvg = document.getElementById("hero-waveform") as SVGElement;
    const noisePath = document.getElementById("wave-noise") as SVGPathElement;
    const phrase = "Finding signal in the noise";

    // Start empty — typing effect
    catchEl.textContent = "";
    gsap.set(catchEl, { opacity: 1 });

    // ------------------------------------------
    // Physics2D: Scatter control points to create
    // autonomous micro-oscillations on the noisy waveform.
    // We animate small proxy objects and rebuild the path each frame.
    // ------------------------------------------
    const NUM_POINTS = 28; // number of control points across waveform
    const wavePoints: { x: number; y: number; baseY: number }[] = [];
    for (let i = 0; i < NUM_POINTS; i++) {
      const x = (i / (NUM_POINTS - 1)) * 800;
      const baseY = 60;
      // Initial noisy offset — organic, seeded variation
      const noiseY = baseY + (Math.sin(i * 1.7) * 25 + Math.cos(i * 2.3) * 15);
      wavePoints.push({ x, y: noiseY, baseY });
    }

    // Build SVG path from control points (smooth cubic bezier through points)
    function buildPath(pts: typeof wavePoints): string {
      if (pts.length < 2) return "";
      let d = `M${pts[0].x},${pts[0].y}`;
      for (let i = 1; i < pts.length; i++) {
        const prev = pts[i - 1];
        const curr = pts[i];
        const cpx = (prev.x + curr.x) / 2;
        d += ` C${cpx},${prev.y} ${cpx},${curr.y} ${curr.x},${curr.y}`;
      }
      return d;
    }

    // Apply Physics2D to each control point — gives them velocity/gravity
    // creating autonomous, organic vertical oscillation
    let physics2dTweens: gsap.core.Tween[] = [];
    function startPhysicsOscillation() {
      wavePoints.forEach((pt, i) => {
        const tween = gsap.to(pt, {
          duration: 2 + Math.random() * 2,
          physics2D: {
            velocity: Math.random() * 30 + 10,
            angle: Math.random() > 0.5 ? 90 : 270, // up or down
            gravity: 0,
          },
          repeat: -1,
          yoyo: true,
          ease: "sine.inOut",
          delay: i * 0.05,
          onUpdate: () => {
            // Constrain vertical movement — elastic return to noise position
            const targetY = pt.baseY + (Math.sin(i * 1.7) * 25 + Math.cos(i * 2.3) * 15);
            pt.y += (targetY - pt.y) * 0.02;
          },
        });
        physics2dTweens.push(tween);
      });
    }

    // RAF loop to continuously update the SVG path during physics phase
    let isAnimatingWave = true;
    function updateWavePath() {
      if (!isAnimatingWave) return;
      noisePath.setAttribute("d", buildPath(wavePoints));
      requestAnimationFrame(updateWavePath);
    }

    // ------------------------------------------
    // Main hero timeline
    // ------------------------------------------
    const heroTl = gsap.timeline({ delay: 0.4 });

    // Phase 0: Waveform appears — fades in with noisy state
    heroTl.to(waveformSvg, {
      opacity: 1, duration: 0.8, ease: "power2.out",
    });

    // Start physics oscillation when waveform appears
    heroTl.add(() => {
      startPhysicsOscillation();
      updateWavePath();
    }, "<");

    // Phase 1: Type the catchphrase while waveform jitters
    let charIndex = 0;
    heroTl.to({}, {
      duration: phrase.length * 0.06,
      ease: "none",
      onUpdate: function() {
        const progress = this.progress();
        const newIndex = Math.floor(progress * phrase.length);
        if (newIndex > charIndex) {
          charIndex = newIndex;
          catchEl.textContent = phrase.slice(0, charIndex);
        }
      },
      onComplete: () => {
        catchEl.textContent = phrase;
      }
    }, "+=0.3");

    // Phase 2: Brief pause
    heroTl.to({}, { duration: 0.5 });
    heroTl.add(() => catchEl.classList.add("typing-done"));

    // Phase 3: THE MORPH — noise resolves to clean signal
    // Kill physics oscillations and smoothly morph
    heroTl.add(() => {
      physics2dTweens.forEach(t => t.kill());
      physics2dTweens = [];
    });

    // Animate all points toward center line (y=60) for smooth convergence
    heroTl.to(wavePoints, {
      y: 60,
      duration: 1.6,
      ease: "power3.inOut",
      stagger: {
        each: 0.03,
        from: "center",
      },
      onUpdate: () => {
        noisePath.setAttribute("d", buildPath(wavePoints));
      },
      onComplete: () => {
        // Final clean line
        isAnimatingWave = false;
        noisePath.setAttribute("d", "M0,60 L800,60");
      },
    });

    // Phase 3b: Simultaneously — name reveals
    heroTl.to("#hero-name", {
      opacity: 1, scale: 1, duration: 1.4,
      ease: "power4.out",
    }, "<+0.2");

    // Phase 3c: Gradient shimmer on name
    heroTl.fromTo("#hero-name", {
      backgroundPosition: "100% 100%",
    }, {
      backgroundPosition: "0% 0%",
      duration: 2.0,
      ease: "power2.inOut",
    }, "<");

    // Phase 3d: Waveform fades to subtle decorative line
    heroTl.to(waveformSvg, {
      opacity: 0.3,
      duration: 1.2,
      ease: "power2.out",
    }, "<+0.5");

    // Phase 3e: Catchphrase fades to subtle
    heroTl.to(catchEl, {
      color: "rgba(248, 247, 244, 0.25)",
      textShadow: "none",
      duration: 1.0,
      ease: "power2.out",
    }, "<");

    // Phase 4: Stroke width thins out for the resolved line
    heroTl.to(noisePath, {
      attr: { "stroke-width": 1 },
      duration: 0.8,
      ease: "power2.out",
    }, "<");

    // Phase 5: Scroll indicator
    heroTl.to("#hero-scroll", {
      opacity: 1, duration: 1.2, ease: "power2.out"
    }, "-=0.5");

    // Parallax on scroll
    ScrollTrigger.create({
      trigger: ".hero",
      start: "top top",
      end: "bottom top",
      scrub: true,
      onUpdate: (self) => {
        const p = self.progress;
        gsap.set(".hero__content", { y: p * 150, opacity: 1 - p * 2 });
        gsap.set("#hero-scroll", { opacity: Math.max(0, 1 - p * 5) });
      },
    });

    // Nav reveal after hero
    const navBar = document.querySelector('.nav-bar');
    if (navBar) {
      ScrollTrigger.create({
        trigger: '.hero',
        start: 'bottom 80px',
        onEnter: () => navBar.classList.add('nav--visible'),
        onLeaveBack: () => navBar.classList.remove('nav--visible'),
      });
    }
  } else {
    // Reduced motion — show everything immediately
    const catchEl = document.getElementById("hero-catchphrase") as HTMLElement;
    catchEl.classList.add("typing-done");
    gsap.set("#hero-catchphrase, #hero-name, #hero-scroll", { opacity: 1 });
    gsap.set("#hero-name", { scale: 1 });
    gsap.set("#hero-waveform", { opacity: 0.3 });
    // Set waveform to clean line immediately
    const noisePath = document.getElementById("wave-noise");
    if (noisePath) noisePath.setAttribute("d", "M0,60 L800,60");

    const navBar = document.querySelector('.nav-bar');
    if (navBar) {
      ScrollTrigger.create({
        trigger: '.hero',
        start: 'bottom 80px',
        onEnter: () => navBar.classList.add('nav--visible'),
        onLeaveBack: () => navBar.classList.remove('nav--visible'),
      });
    }
  }

  // ========================================
  // STATEMENT — per-word scroll color reveal
  // ========================================
  const stEl = document.getElementById("statement-1");
  if (stEl && !reducedMotion) {
    const split = SplitText.create(stEl, { type: "words" });

    // Start all words dim
    split.words.forEach((w: HTMLElement) => w.classList.add("char-dim"));

    ScrollTrigger.create({
      trigger: ".statement",
      start: "top 70%",
      end: "bottom 40%",
      scrub: true,
      onUpdate: (self) => {
        const progress = self.progress;
        split.words.forEach((w: HTMLElement, i: number) => {
          const wordProgress = i / split.words.length;
          if (progress > wordProgress) {
            w.style.color = "var(--ink)";
          } else {
            w.style.color = "";
          }
        });
      },
    });
  }

  // ========================================
  // PANEL REVEALS
  // ========================================
  if (!reducedMotion) {
    gsap.utils.toArray<HTMLElement>(".panel").forEach((panel, i) => {
      gsap.from(panel, {
        y: 30, opacity: 0,
        duration: 0.6,
        delay: i * 0.08,
        ease: "power2.out",
        scrollTrigger: {
          trigger: panel,
          start: "top 90%",
          once: true,
        },
      });
    });
  }
</script>
