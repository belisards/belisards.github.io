---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Adriano Belisario" description="Data journalist & researcher. Oxford, UNHCR, Bellingcat, Forensic Architecture.">

  <!-- ========== FULL-SCREEN HERO ========== -->
  <section class="hero">
    <canvas id="network-canvas" aria-hidden="true"></canvas>

    <div class="hero__content">
      <h1 class="hero__name" id="hero-name" aria-label="Adriano Belisario">
        <span class="hero__line" id="line-1">Adriano</span>
        <span class="hero__line" id="line-2">Belisario</span>
      </h1>
      <p class="hero__tagline" id="hero-tagline">
        Data, journalism &amp; open&#8209;source
      </p>
    </div>

    <div class="hero__scroll-hint" id="scroll-hint" aria-hidden="true">
      <span></span>
    </div>
  </section>

  <!-- ========== BIO SECTION ========== -->
  <section class="bio-section">
    <div class="bio-section__inner">
      <p class="bio-section__text reveal">
        Combining expertise in communication, open-source technologies, and data
        to address important social concerns.
      </p>
      <p class="bio-section__text reveal">
        Currently collaborating with the
        <a href="https://www.jointdatacenter.org/">Joint Data Center on Forced Displacement</a>
        and the <a href="https://netlab.eco.ufrj.br/">Netlab</a> laboratory from the Federal University of Rio de Janeiro.
      </p>
      <div class="bio-section__badges reveal">
        <span class="data-badge data-badge--violet">Oxford Internet Institute</span>
        <span class="data-badge data-badge--warm">Bellingcat</span>
        <span class="data-badge">Forensic Architecture</span>
        <span class="data-badge data-badge--teal">UNHCR</span>
        <span class="data-badge data-badge--warm">Agência Pública</span>
      </div>
    </div>
  </section>

  <!-- ========== NAVIGATION PANELS ========== -->
  <section class="panels">

    <a href="/code/" class="panel panel--teal" data-color="var(--signal-teal)">
      <div class="panel__bg"></div>
      <div class="panel__content">
        <span class="panel__number mono">01</span>
        <h2 class="panel__title">Code</h2>
        <p class="panel__desc">Data projects &amp; code repositories.<br>NLP, geodata, network analysis.</p>
        <span class="panel__cta mono">Explore &rarr;</span>
      </div>
    </a>

    <a href="/publications/" class="panel panel--violet" data-color="var(--signal-violet)">
      <div class="panel__bg"></div>
      <div class="panel__content">
        <span class="panel__number mono">02</span>
        <h2 class="panel__title">Publications</h2>
        <p class="panel__desc">Academic papers, investigations,<br>books &amp; tutorials.</p>
        <span class="panel__cta mono">Explore &rarr;</span>
      </div>
    </a>

    <a href="/events/" class="panel panel--warm" data-color="var(--signal-warm)">
      <div class="panel__bg"></div>
      <div class="panel__content">
        <span class="panel__number mono">03</span>
        <h2 class="panel__title">Events</h2>
        <p class="panel__desc">Conferences, lectures, workshops<br>across four continents.</p>
        <span class="panel__cta mono">Explore &rarr;</span>
      </div>
    </a>

    <a href="/about/" class="panel panel--blue" data-color="var(--signal-primary)">
      <div class="panel__bg"></div>
      <div class="panel__content">
        <span class="panel__number mono">04</span>
        <h2 class="panel__title">About</h2>
        <p class="panel__desc">CV, education, experience<br>&amp; collaborations.</p>
        <span class="panel__cta mono">Explore &rarr;</span>
      </div>
    </a>

  </section>

</BaseLayout>

<style>
  /* ============================
     HERO — Full viewport
     ============================ */
  .hero {
    position: relative;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-left: calc(-50vw + 50%);
    background: var(--ink);
  }

  #network-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 0 2rem;
  }

  .hero__name {
    font-size: clamp(3.5rem, 12vw, 10rem);
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 0.9;
    color: var(--canvas);
    margin: 0;
  }

  .hero__line {
    display: block;
    overflow: hidden;
    opacity: 0;
  }

  .hero__tagline {
    font-family: var(--font-mono);
    font-size: clamp(0.75rem, 1.5vw, 1rem);
    color: var(--signal-primary);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-top: 1.5rem;
    opacity: 0;
  }

  /* Scroll hint */
  .hero__scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    opacity: 0;
  }

  .hero__scroll-hint span {
    display: block;
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, var(--signal-primary), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; transform: scaleY(0.6); transform-origin: top; }
    50% { opacity: 1; transform: scaleY(1); transform-origin: top; }
  }

  /* ============================
     BIO SECTION
     ============================ */
  .bio-section {
    padding: 6rem 2rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .bio-section__inner {
    max-width: 680px;
  }

  .bio-section__text {
    font-size: 1.2rem;
    line-height: 2;
    margin-bottom: 1.5rem;
  }

  .bio-section__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  /* ============================
     NAVIGATION PANELS — Full bleed
     ============================ */
  .panels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    min-height: 100vh;
  }

  .panel {
    position: relative;
    display: flex;
    align-items: flex-end;
    padding: 3rem;
    min-height: 50vh;
    text-decoration: none;
    color: var(--canvas);
    overflow: hidden;
    cursor: pointer;
  }

  .panel__bg {
    position: absolute;
    inset: 0;
    background: var(--ink);
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    z-index: 0;
  }

  .panel:hover .panel__bg {
    transform: scale(1.05);
  }

  .panel__content {
    position: relative;
    z-index: 1;
    opacity: 0;
    transform: translateY(40px);
  }

  .panel__number {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: rgba(248, 247, 244, 0.4);
    display: block;
    margin-bottom: 0.75rem;
  }

  .panel__title {
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--canvas);
    margin: 0 0 0.75rem;
    line-height: 1;
  }

  .panel__desc {
    font-size: 0.85rem;
    line-height: 1.7;
    color: rgba(248, 247, 244, 0.6);
    margin-bottom: 1.5rem;
  }

  .panel__cta {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--canvas);
    border-bottom: 1px solid rgba(248, 247, 244, 0.3);
    padding-bottom: 0.25rem;
    transition: border-color 0.3s ease;
  }

  .panel:hover .panel__cta {
    border-color: var(--canvas);
  }

  /* Panel accent colors — thin top border glow */
  .panel--teal .panel__bg { border-top: 3px solid var(--signal-teal); }
  .panel--violet .panel__bg { border-top: 3px solid var(--signal-violet); }
  .panel--warm .panel__bg { border-top: 3px solid var(--signal-warm); }
  .panel--blue .panel__bg { border-top: 3px solid var(--signal-primary); }

  /* On hover, the accent color lights up the background */
  .panel--teal:hover .panel__bg { background: color-mix(in srgb, var(--ink) 92%, var(--signal-teal)); }
  .panel--violet:hover .panel__bg { background: color-mix(in srgb, var(--ink) 92%, var(--signal-violet)); }
  .panel--warm:hover .panel__bg { background: color-mix(in srgb, var(--ink) 92%, var(--signal-warm)); }
  .panel--blue:hover .panel__bg { background: color-mix(in srgb, var(--ink) 92%, var(--signal-primary)); }

  /* ============================
     RESPONSIVE
     ============================ */
  @media screen and (max-width: 768px) {
    .hero__name {
      font-size: clamp(2.5rem, 14vw, 5rem);
    }

    .panels {
      grid-template-columns: 1fr;
    }

    .panel {
      min-height: 40vh;
    }

    .bio-section {
      padding: 4rem 1.5rem;
    }

    .bio-section__text {
      font-size: 1.05rem;
    }
  }

  @media screen and (max-width: 480px) {
    .panel {
      padding: 2rem;
      min-height: 35vh;
    }

    .panel__title {
      font-size: 2rem;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";
  import { CustomEase } from "gsap/CustomEase";

  gsap.registerPlugin(ScrollTrigger, SplitText, CustomEase);

  CustomEase.create("heroReveal", "M0,0 C0.11,0.49 0.17,0.98 0.37,1 0.55,1.02 0.68,1 1,1");

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ========================================
  // INTERACTIVE PARTICLE NETWORK
  // ========================================
  const canvas = document.getElementById("network-canvas") as HTMLCanvasElement;
  const ctx = canvas?.getContext("2d");

  interface Node {
    x: number;
    y: number;
    baseX: number;
    baseY: number;
    vx: number;
    vy: number;
    radius: number;
    color: string;
  }

  const mouse = { x: -9999, y: -9999, active: false };
  let nodes: Node[] = [];
  const COLORS = [
    "rgba(37, 99, 235,",   // blue
    "rgba(13, 148, 136,",  // teal
    "rgba(124, 58, 237,",  // violet
    "rgba(232, 93, 4,",    // warm
    "rgba(248, 247, 244,", // white
  ];
  const CONNECTION_DIST = 180;
  const MOUSE_RADIUS = 200;
  const MOUSE_FORCE = 0.08;

  function resize() {
    if (!canvas) return;
    canvas.width = canvas.offsetWidth;
    canvas.height = canvas.offsetHeight;
    initNodes();
  }

  function initNodes() {
    if (!canvas) return;
    nodes = [];
    const area = canvas.width * canvas.height;
    const count = Math.min(120, Math.max(40, Math.floor(area / 12000)));
    for (let i = 0; i < count; i++) {
      const x = Math.random() * canvas.width;
      const y = Math.random() * canvas.height;
      nodes.push({
        x, y,
        baseX: x,
        baseY: y,
        vx: (Math.random() - 0.5) * 0.6,
        vy: (Math.random() - 0.5) * 0.6,
        radius: Math.random() * 2.5 + 1,
        color: COLORS[Math.floor(Math.random() * COLORS.length)],
      });
    }
  }

  function animate() {
    if (!ctx || !canvas) return;
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // Update + draw
    for (let i = 0; i < nodes.length; i++) {
      const a = nodes[i];

      // Mouse interaction — push nodes away
      if (mouse.active) {
        const dx = a.x - mouse.x;
        const dy = a.y - mouse.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < MOUSE_RADIUS && dist > 0) {
          const force = (MOUSE_RADIUS - dist) / MOUSE_RADIUS * MOUSE_FORCE;
          a.vx += (dx / dist) * force * 8;
          a.vy += (dy / dist) * force * 8;
        }
      }

      // Drift + slight gravity back to base
      a.vx += (a.baseX - a.x) * 0.0005;
      a.vy += (a.baseY - a.y) * 0.0005;

      // Friction
      a.vx *= 0.98;
      a.vy *= 0.98;

      a.x += a.vx;
      a.y += a.vy;

      // Bounce off edges
      if (a.x < 0) { a.x = 0; a.vx *= -0.5; }
      if (a.x > canvas.width) { a.x = canvas.width; a.vx *= -0.5; }
      if (a.y < 0) { a.y = 0; a.vy *= -0.5; }
      if (a.y > canvas.height) { a.y = canvas.height; a.vy *= -0.5; }

      // Draw connections
      for (let j = i + 1; j < nodes.length; j++) {
        const b = nodes[j];
        const ddx = a.x - b.x;
        const ddy = a.y - b.y;
        const d = Math.sqrt(ddx * ddx + ddy * ddy);
        if (d < CONNECTION_DIST) {
          const alpha = (1 - d / CONNECTION_DIST) * 0.15;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.strokeStyle = `rgba(37, 99, 235, ${alpha})`;
          ctx.lineWidth = 0.6;
          ctx.stroke();
        }
      }

      // Draw mouse connections to nearby nodes
      if (mouse.active) {
        const mdx = a.x - mouse.x;
        const mdy = a.y - mouse.y;
        const md = Math.sqrt(mdx * mdx + mdy * mdy);
        if (md < MOUSE_RADIUS) {
          const alpha = (1 - md / MOUSE_RADIUS) * 0.3;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(mouse.x, mouse.y);
          ctx.strokeStyle = `rgba(248, 247, 244, ${alpha})`;
          ctx.lineWidth = 0.4;
          ctx.stroke();
        }
      }

      // Draw node
      ctx.beginPath();
      ctx.arc(a.x, a.y, a.radius, 0, Math.PI * 2);
      ctx.fillStyle = a.color + "0.6)";
      ctx.fill();
    }

    requestAnimationFrame(animate);
  }

  if (canvas && ctx && !prefersReducedMotion) {
    resize();
    animate();
    window.addEventListener("resize", resize);

    canvas.parentElement?.addEventListener("mousemove", (e) => {
      const rect = canvas.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
      mouse.active = true;
    });

    canvas.parentElement?.addEventListener("mouseleave", () => {
      mouse.active = false;
      mouse.x = -9999;
      mouse.y = -9999;
    });

    // Touch support
    canvas.parentElement?.addEventListener("touchmove", (e) => {
      const rect = canvas.getBoundingClientRect();
      const t = e.touches[0];
      mouse.x = t.clientX - rect.left;
      mouse.y = t.clientY - rect.top;
      mouse.active = true;
    }, { passive: true });

    canvas.parentElement?.addEventListener("touchend", () => {
      mouse.active = false;
    });
  } else if (canvas && ctx && prefersReducedMotion) {
    // Static snapshot
    resize();
    for (let i = 0; i < nodes.length; i++) {
      const a = nodes[i];
      ctx.beginPath();
      ctx.arc(a.x, a.y, a.radius, 0, Math.PI * 2);
      ctx.fillStyle = a.color + "0.4)";
      ctx.fill();
      for (let j = i + 1; j < nodes.length; j++) {
        const b = nodes[j];
        const d = Math.hypot(a.x - b.x, a.y - b.y);
        if (d < CONNECTION_DIST) {
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.strokeStyle = `rgba(37, 99, 235, ${(1 - d / CONNECTION_DIST) * 0.1})`;
          ctx.lineWidth = 0.5;
          ctx.stroke();
        }
      }
    }
  }

  // ========================================
  // HERO TEXT ANIMATION
  // ========================================
  if (!prefersReducedMotion) {
    const master = gsap.timeline({ delay: 0.3 });

    // Name — SplitText per-character with 3D transforms
    const line1Split = SplitText.create("#line-1", { type: "chars" });
    const line2Split = SplitText.create("#line-2", { type: "chars" });

    master.to("#line-1", { opacity: 1, duration: 0.01 });
    master.from(line1Split.chars, {
      y: 80,
      rotationX: -80,
      opacity: 0,
      duration: 0.8,
      ease: "heroReveal",
      stagger: 0.04,
    });

    master.to("#line-2", { opacity: 1, duration: 0.01 }, "-=0.4");
    master.from(line2Split.chars, {
      y: 80,
      rotationX: -80,
      opacity: 0,
      duration: 0.8,
      ease: "heroReveal",
      stagger: 0.04,
    }, "-=0.4");

    // Tagline fade
    master.to("#hero-tagline", {
      opacity: 1,
      duration: 1,
      ease: "power2.out",
    }, "-=0.3");

    // Scroll hint
    master.to("#scroll-hint", {
      opacity: 1,
      duration: 0.8,
      ease: "power2.out",
    }, "-=0.5");

    // Parallax hero on scroll
    ScrollTrigger.create({
      trigger: ".hero",
      start: "top top",
      end: "bottom top",
      scrub: 0.5,
      onUpdate: (self) => {
        const p = self.progress;
        gsap.set(".hero__content", { y: p * 120, opacity: 1 - p * 1.5 });
        gsap.set("#scroll-hint", { opacity: Math.max(0, 1 - p * 4) });
      },
    });
  } else {
    // Show everything immediately for reduced motion
    gsap.set("#line-1, #line-2, #hero-tagline, #scroll-hint", { opacity: 1 });
  }

  // ========================================
  // PANEL SCROLL REVEALS
  // ========================================
  document.querySelectorAll(".panel__content").forEach((content) => {
    if (prefersReducedMotion) {
      gsap.set(content, { opacity: 1, y: 0 });
      return;
    }

    gsap.to(content, {
      opacity: 1,
      y: 0,
      duration: 0.8,
      ease: "power3.out",
      scrollTrigger: {
        trigger: content.closest(".panel"),
        start: "top 75%",
        once: true,
      },
    });
  });
</script>
