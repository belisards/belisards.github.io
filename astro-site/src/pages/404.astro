---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Signal Lost" description="404 — this page does not exist.">
  <div class="page-wrapper">
    <div class="content-wrapper four-oh-four">

      <span class="data-badge data-badge--warm">404</span>

      <h1>Signal Lost</h1>

      <div class="waveform waveform--broken" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span>
      </div>

      <p class="secondary">
        The data point you're looking for doesn't exist in this dataset, or the coordinates have changed.
      </p>

      <p>
        <a href="/">Return to origin &rarr;</a>
      </p>

    </div>
  </div>
</BaseLayout>

<style>
  .four-oh-four {
    text-align: center;
    padding-top: 6rem;
    padding-bottom: 6rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .four-oh-four h1 {
    font-size: 3rem;
    margin: 0.5rem 0;
  }

  .four-oh-four .waveform--broken {
    margin: 1rem 0;
  }

  .four-oh-four .waveform--broken span {
    height: 20px;
  }

  .four-oh-four p {
    font-size: 1rem;
    max-width: 400px;
  }
</style>
