---
interface TocItem {
  label: string;
  id: string;
}

interface Props {
  items: TocItem[];
  /** compact: short labels (e.g. years). No inner scroll box; horizontal sticky bar on small screens. */
  variant?: 'default' | 'compact';
}

const { items, variant = 'default' } = Astro.props;
---

<nav class={`toc${variant === 'compact' ? ' toc--compact' : ''}`} aria-label="Table of contents">
  <ul class="toc__list">
    {items.map((item) => (
      <li class="toc__item">
        <a href={`#${item.id}`} class="toc__link" data-toc-link={item.id}>{item.label}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .toc {
    position: sticky;
    top: calc(var(--nav-height) + 2rem);
    align-self: start;
    max-height: calc(100vh - var(--nav-height) - 4rem);
    overflow-y: auto;
    padding-right: 1.5rem;
    border-right: 1px solid var(--border);
  }

  .toc__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .toc__link {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--ink-tertiary);
    text-decoration: none;
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
    transition: color 0.2s ease, background 0.2s ease;
    white-space: nowrap;
  }

  .toc__link:hover {
    color: var(--ink);
    background: rgba(37, 99, 235, 0.04);
  }

  .toc__link.active {
    color: var(--signal-primary);
    background: rgba(37, 99, 235, 0.06);
  }

  @media screen and (max-width: 1024px) {
    .toc {
      display: none;
    }
  }

  /* ---- Compact variant (year rail) ---- */
  .toc--compact {
    max-height: none;
    overflow: visible;
  }

  .toc--compact .toc__list {
    gap: 0;
  }

  .toc--compact .toc__link {
    padding: 0.2rem 0.75rem;
    font-size: 0.72rem;
    line-height: 1.5;
  }

  @media screen and (max-width: 1024px) {
    .toc--compact {
      display: block;
      position: sticky;
      top: var(--nav-height);
      z-index: 5;
      margin: 0 -1rem 1.5rem;
      padding: 0.5rem 1rem;
      border-right: none;
      border-bottom: 1px solid var(--border);
      background: var(--canvas);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .toc--compact::-webkit-scrollbar {
      display: none;
    }

    .toc--compact .toc__list {
      flex-direction: row;
      gap: 0.25rem;
    }

    .toc--compact .toc__link {
      padding: 0.3rem 0.6rem;
    }
  }
</style>

<script>
  // Highlight active TOC link based on scroll position
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
  if (tocLinks.length > 0) {
    const ids = Array.from(tocLinks).map(l => l.dataset.tocLink!);
    const sections = ids.map(id => document.getElementById(id)).filter(Boolean) as HTMLElement[];

    function updateActive() {
      let activeId = ids[0];
      for (const section of sections) {
        const rect = section.getBoundingClientRect();
        if (rect.top <= 120) {
          activeId = section.id;
        }
      }
      tocLinks.forEach(link => {
        const on = link.dataset.tocLink === activeId;
        link.classList.toggle('active', on);
        if (on && link.closest('.toc--compact')) {
          const bar = link.closest('.toc--compact') as HTMLElement;
          if (bar.scrollWidth > bar.clientWidth) {
            bar.scrollLeft = link.offsetLeft - bar.clientWidth / 2 + link.offsetWidth / 2;
          }
        }
      });
    }

    window.addEventListener('scroll', updateActive, { passive: true });
    updateActive();
  }
</script>
